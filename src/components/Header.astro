---
import { site } from "../data/site";
interface Props { currentPath: string; lang: "en" | "de"; alternatePath?: string }
const { currentPath, lang, alternatePath } = Astro.props;
const items = lang === "de" ? [{ href: "/de#tool", label: "Kostenloses Tool" }, { href: "/de/lernen", label: "Lernen" }, { href: "/de/methode", label: "So funktioniert es" }] : site.navigation;
const home = lang === "de" ? "/de" : "/";
const switchPath = alternatePath ?? (lang === "de" ? "/" : "/de");
const isCurrent = (href: string) => href === home ? currentPath === home : currentPath === href || currentPath.startsWith(`${href}/`);
---
<header class="site-header"><a class="wordmark" href={home} aria-label={`${site.domain} ${lang === "de" ? "Startseite" : "home"}`}><span class="wordmark-mark" aria-hidden="true"></span><span>{site.domain}</span></a><nav class="desktop-nav" aria-label={lang === "de" ? "Hauptnavigation" : "Primary navigation"}>{items.map(item => <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}</nav><a class="header-action" href={`${home}#tool`}>{lang === "de" ? "Kostenlos testen" : "Try it free"}</a><nav class="language-switch" aria-label={lang === "de" ? "Sprache wählen" : "Choose language"}><span lang="en" aria-current={lang === "en" ? "page" : undefined}>EN</span><a href={switchPath} lang={lang === "de" ? "en" : "de"} hreflang={lang === "de" ? "en" : "de"}>{lang === "de" ? "EN" : "DE"}</a><span lang="de" aria-current={lang === "de" ? "page" : undefined}>DE</span></nav><details class="mobile-nav"><summary>{lang === "de" ? "Menü" : "Menu"}</summary><nav aria-label={lang === "de" ? "Mobile Navigation" : "Mobile navigation"}>{items.map(item => <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}<a href={switchPath}>{lang === "de" ? "English" : "Deutsch"}</a></nav></details></header>
