---
import { site } from "../data/site";
interface Props { lang?: "en" | "de" }
const { lang = "en" } = Astro.props;
const de = lang === "de";
---
<footer class="site-footer"><div><p class="footer-title">{de ? "Wer diese Seite betreibt" : "Who runs this site"}</p><p>{de ? "Betrieben von Matthias Ramahi. ai-fanout.com, Contextter und SEO Fanout haben denselben Eigentümer; sie sind keine unabhängigen Empfehlungen." : site.ownershipDisclosure}</p></div><div><p class="footer-state">{de ? "Kostenlos nutzbar" : "Free to use"}</p><p>{de ? "OpenAI und Gemini · ohne Anmeldung" : "OpenAI and Gemini · no signup"}</p></div><nav aria-label={de ? "Fußzeilennavigation" : "Footer navigation"}><a href={de ? "/de/lernen" : "/library"}>{de ? "Lernen" : "Guides"}</a><a href={de ? "/de/methode" : "/methodology"}>{de ? "So funktioniert es" : "How the tool works"}</a><a href="/transparency">{de ? "Quellen und Rechte" : "Sources & rights"}</a><a href="/impressum">Impressum</a><a href="/datenschutz">Datenschutz</a><a href={site.githubUrl} rel="external">{de ? "Quellcode" : "Source code"}</a></nav></footer>
