---
import { MODEL_OPTIONS } from "../server/fanout/contracts.mjs";
interface Props { locale?: "en" | "de" }
const { locale = "en" } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const enabled = import.meta.env.PUBLIC_FANOUT_ENABLED === "true" && Boolean(siteKey);
const de = locale === "de";
const copy = de ? {
  keyword: "Keyword oder kurze Frage", placeholder: "beste SEO Tools", country: "Land", language: "Sprache", model: "Modell wählen", auto: "Alle Länder", submit: "Fanout erstellen", loading: "Fanout wird erstellt …", disabled: "Das kostenlose Tool ist vorübergehend nicht verfügbar.", resultCount: "10 weiterführende Suchanfragen", original: "Dein Keyword", locale: "Markt und Sprache", evidence: "Einordnung", evidenceValue: "Modellierter Fanout — keine versteckten Provider-Queries", intent: "Intent", why: "Warum", copyAll: "Alle kopieren", copied: "Kopiert", again: "Neues Keyword", close: "Schließen", notice: "Simulation auf Basis des gewählten Modells. Kein Protokoll versteckter Suchanfragen oder Gedankengänge."
} : {
  keyword: "Keyword or short question", placeholder: "best SEO tools", country: "Country", language: "Language", model: "Choose a model", auto: "All countries", submit: "Build fanout", loading: "Building fanout …", disabled: "The free tool is temporarily unavailable.", resultCount: "10 follow-up searches", original: "Your keyword", locale: "Market and language", evidence: "Evidence", evidenceValue: "Modelled fanout — not hidden provider queries", intent: "Intent", why: "Why", copyAll: "Copy all", copied: "Copied", again: "New keyword", close: "Close", notice: "A simulation from the selected model. Not a log of hidden searches or chain of thought."
};
---
<section data-fanout-planner data-site-key={siteKey} data-enabled={String(enabled)} data-locale={locale} data-loading-label={copy.loading} data-submit-label={copy.submit} data-copied-label={copy.copied}>
  <form data-planner-form>
    <div class="query-line">
      <label for={`fanout-keyword-${locale}`}>{copy.keyword}</label>
      <div><input id={`fanout-keyword-${locale}`} name="keyword" maxlength="100" placeholder={copy.placeholder} required autocomplete="off"/><output data-keyword-count>0 / 100</output></div>
      <button type="submit" disabled={!enabled}>{copy.submit}<span aria-hidden="true">→</span></button>
    </div>
    <fieldset class="model-picker"><legend>{copy.model}</legend>{MODEL_OPTIONS.map((model, index) => <label><input type="radio" name="model" value={model.id} checked={index === 0}/><span><strong>{model.label}</strong><small>{model.provider}</small></span></label>)}</fieldset>
    <div class="tool-options">
      <label>{copy.country}<select name="country"><option value="">{copy.auto}</option><option value="DE">Deutschland</option><option value="US">United States</option><option value="GB">United Kingdom</option><option value="AT">Österreich</option><option value="CH">Schweiz</option><option value="FR">France</option><option value="ES">España</option><option value="IT">Italia</option><option value="NL">Nederland</option></select></label>
      <label>{copy.language}<select name="language"><option value="en" selected={!de}>English</option><option value="de" selected={de}>Deutsch</option></select></label>
      <div class="human-check"><span>{de ? "Missbrauchsschutz" : "Abuse protection"}</span><div data-turnstile-slot aria-label={de ? "Bestätigung, dass du ein Mensch bist" : "Human verification"}></div></div>
    </div>
    {!enabled && <p role="status" class="tool-disabled">{copy.disabled}</p>}
    <p data-form-status aria-live="polite" class="form-status"></p>
  </form>

  <dialog data-result-dialog aria-labelledby={`fanout-result-title-${locale}`}>
    <div class="result-modal">
      <button class="modal-close" type="button" data-dialog-close aria-label={copy.close}><span aria-hidden="true">×</span><span>{copy.close}</span></button>
      <header class="result-title"><p>{copy.original}</p><h2 id={`fanout-result-title-${locale}`} data-result-keyword></h2><strong><span data-result-count>10</span> {copy.resultCount.replace(/^10 /, "")}</strong></header>
      <div class="result-meta"><div><span>{de ? "Modell" : "Model"}</span><b data-result-model></b></div><div><span>{copy.locale}</span><b data-result-locale></b></div><div><span>{copy.evidence}</span><b>{copy.evidenceValue}</b></div></div>
      <div class="result-actions"><button type="button" data-copy-results>{copy.copyAll}</button><button type="button" data-new-keyword>{copy.again}</button></div>
      <ol data-result-queries aria-label={copy.resultCount}></ol>
      <footer><p data-result-notice>{copy.notice}</p><span data-result-date></span></footer>
    </div>
  </dialog>
</section>
<script src="../scripts/fanout-planner.ts"></script>
