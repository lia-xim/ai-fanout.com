---
import { MODEL_OPTIONS } from "../server/fanout/contracts.mjs";
interface Props { locale?: "en" | "de" }
const { locale = "en" } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const modelledEnabled = import.meta.env.PUBLIC_FANOUT_ENABLED === "true" && Boolean(siteKey);
const nativeEnabled = import.meta.env.PUBLIC_NATIVE_FANOUT_ENABLED === "true" && Boolean(siteKey);
const enabled = modelledEnabled || nativeEnabled;
const de = locale === "de";
const copy = de ? {
  keyword: "Keyword oder kurze Frage", placeholder: "beste SEO Tools", country: "Land", language: "Sprache", model: "Modell wählen", provider: "Anbieter wählen", auto: "Alle Länder", submit: "Suchanfragen anzeigen", loading: "Suche wird ausgeführt …", disabled: "Dieser Modus ist noch nicht freigeschaltet.", resultCount: "ausgeführte Suchanfragen", original: "Deine Eingabe", locale: "Markt und Sprache", evidence: "Was du siehst", intent: "Intent", why: "Warum", copyAll: "Alle kopieren", copied: "Kopiert", again: "Neue Eingabe", close: "Schließen", native: "Native Fanout", nativeHelp: "Tatsächliche Websuchen von OpenAI oder Gemini in diesem Lauf.", modelled: "Suchideen", modelledHelp: "Zehn mögliche Suchrichtungen ohne Websuche.", sources: "Zitierte Quellen", save: "Auf diesem Gerät speichern", saved: "Gespeichert", downloadJson: "JSON laden", downloadCsv: "CSV laden", savedTitle: "Auf diesem Gerät gespeichert", savedHelp: "Nur in diesem Browser · maximal 20 Ergebnisse · automatische Löschung nach 30 Tagen", savedEmpty: "Noch keine Ergebnisse gespeichert.", openSaved: "Öffnen", deleteSaved: "Löschen", clearSaved: "Alle löschen", loadingTitle: "Die KI sucht gerade im Web", loadingHelp: "Ein nativer Lauf kann bis zu 20 Sekunden dauern. Der Balken zeigt Aktivität, keinen Prozentfortschritt.", quota: "20 kostenlose Läufe innerhalb von 24 Stunden pro Internetverbindung.", loadingSteps: ["Sicherheitsprüfung abgeschlossen", "Anfrage an den Anbieter gesendet", "Warten auf die Anbieter-Antwort", "Suchanfragen und Quellen aufbereiten"]
} : {
  keyword: "Keyword or short question", placeholder: "best SEO tools", country: "Country", language: "Language", model: "Choose a model", provider: "Choose a provider", auto: "All countries", submit: "Show search queries", loading: "Running search …", disabled: "This mode is not enabled yet.", resultCount: "executed search queries", original: "Your input", locale: "Market and language", evidence: "What this shows", intent: "Intent", why: "Why", copyAll: "Copy all", copied: "Copied", again: "New input", close: "Close", native: "Native fanout", nativeHelp: "Actual web searches from OpenAI or Gemini in this run.", modelled: "Search ideas", modelledHelp: "Ten possible search directions without web search.", sources: "Cited sources", save: "Save on this device", saved: "Saved", downloadJson: "Download JSON", downloadCsv: "Download CSV", savedTitle: "Saved on this device", savedHelp: "This browser only · up to 20 results · automatically deleted after 30 days", savedEmpty: "No saved results yet.", openSaved: "Open", deleteSaved: "Delete", clearSaved: "Clear all", loadingTitle: "The AI is searching the web", loadingHelp: "A native run can take up to 20 seconds. The bar shows activity, not a percentage.", quota: "20 free runs within 24 hours per internet connection.", loadingSteps: ["Human verification passed", "Request sent to the provider", "Waiting for the provider response", "Preparing queries and sources"]
};
const exampleTopics = de
  ? ["KI-Suche SEO", "ChatGPT Suchanfragen", "KI-Zitate"]
  : ["SEO for AI search", "ChatGPT search queries", "AI search citations"];
---
<section data-fanout-planner data-site-key={siteKey} data-enabled={String(enabled)} data-native-enabled={String(nativeEnabled)} data-modelled-enabled={String(modelledEnabled)} data-locale={locale} data-loading-label={copy.loading} data-submit-label={copy.submit} data-copied-label={copy.copied}>
  <form data-planner-form>
    <fieldset class="mode-picker"><legend>{de ? "Modus" : "Mode"}</legend>
      <label><input type="radio" name="mode" value="native" checked={nativeEnabled}/><span><strong>{copy.native}</strong><small>{copy.nativeHelp}</small></span></label>
      <label><input type="radio" name="mode" value="modelled" checked={!nativeEnabled}/><span><strong>{copy.modelled}</strong><small>{copy.modelledHelp}</small></span></label>
    </fieldset>
    <div class="query-line">
      <label for={`fanout-keyword-${locale}`}>{copy.keyword}</label>
      <div><input id={`fanout-keyword-${locale}`} name="keyword" maxlength="60" placeholder={copy.placeholder} required autocomplete="off"/><output data-keyword-count>0 / 60</output></div>
      <button type="submit" disabled={!enabled}>{copy.submit}<span aria-hidden="true">→</span></button>
    </div>
    <div class="example-topics" aria-label={de ? "Beispielthemen einsetzen" : "Use an example topic"}>
      <span>{de ? "Beispiele" : "Try an example"}</span>
      {exampleTopics.map(topic => <button type="button" data-example-topic={topic}>{topic}</button>)}
    </div>
    <fieldset class="model-picker native-picker" data-native-picker><legend>{copy.provider}</legend>
      <label><input type="radio" name="provider" value="openai" checked/><span><strong>OpenAI</strong><small>GPT-5.6 Luna</small></span></label>
      <label><input type="radio" name="provider" value="gemini"/><span><strong>Gemini</strong><small>Gemini 3.7 Flash</small></span></label>
    </fieldset>
    <fieldset class="model-picker modelled-picker" data-modelled-picker hidden><legend>{copy.model}</legend>{MODEL_OPTIONS.map((model, index) => <label><input type="radio" name="model" value={model.id} checked={index === 0}/><span><strong>{model.label}</strong><small>{model.provider}</small></span></label>)}</fieldset>
    <div class="tool-options">
      <label>{copy.country}<select name="country"><option value="">{copy.auto}</option><option value="DE">Deutschland</option><option value="US">United States</option><option value="GB">United Kingdom</option><option value="AT">Österreich</option><option value="CH">Schweiz</option><option value="FR">France</option><option value="ES">España</option><option value="IT">Italia</option><option value="NL">Nederland</option></select></label>
      <label>{copy.language}<select name="language"><option value="en" selected={!de}>English</option><option value="de" selected={de}>Deutsch</option></select></label>
      <div class="human-check"><span>{de ? "Missbrauchsschutz" : "Abuse protection"}</span><div data-turnstile-slot aria-label={de ? "Bestätigung, dass du ein Mensch bist" : "Human verification"}></div></div>
    </div>
    <p role="status" class="tool-disabled" data-mode-availability hidden>{copy.disabled}</p>
    <p class="quota-status" data-quota-status>{copy.quota}</p>
    <p data-form-status aria-live="polite" class="form-status"></p>
  </form>

  <dialog data-result-dialog aria-labelledby={`fanout-result-title-${locale}`}>
    <div class="result-modal">
      <button class="modal-close" type="button" data-dialog-close aria-label={copy.close}><span aria-hidden="true">×</span><span>{copy.close}</span></button>
      <header class="result-title"><p>{copy.original}</p><h2 id={`fanout-result-title-${locale}`} data-result-keyword></h2><strong><span data-result-count>10</span> {copy.resultCount.replace(/^10 /, "")}</strong></header>
      <div class="result-meta"><div><span>{de ? "Modell" : "Model"}</span><b data-result-model></b></div><div><span>{copy.locale}</span><b data-result-locale></b></div><div><span>{copy.evidence}</span><b data-result-evidence></b></div></div>
      <div class="result-actions"><button type="button" data-copy-results>{copy.copyAll}</button><button type="button" data-save-result>{copy.save}</button><button type="button" data-download-json>{copy.downloadJson}</button><button type="button" data-download-csv>{copy.downloadCsv}</button><button type="button" class="compare-provider" data-compare-provider><span data-compare-provider-label>{de ? "Mit anderem Modell vergleichen" : "Compare with the other model"}</span><span aria-hidden="true">→</span></button><button type="button" data-new-keyword>{copy.again}</button></div>
      <section class="result-reading" aria-labelledby={`result-reading-title-${locale}`}>
        <div class="reading-head"><div><span>{de ? "DIREKT VOM ANBIETER" : "DIRECT FROM THE PROVIDER"}</span><h3 id={`result-reading-title-${locale}`}>{de ? "Was dieser Lauf gezeigt hat" : "What this run exposed"}</h3></div><p>{de ? "Query-Strings, Quellen und Zähler aus dem API-Response" : "Query strings, sources and counts from the API response"}</p></div>
        <dl class="result-summary"><div><dt>{de ? "Suchanfragen" : "Search queries"}</dt><dd data-summary-queries>0</dd></div><div><dt>{de ? "Quellendomains" : "Source domains"}</dt><dd data-summary-domains>0</dd></div><div><dt>{de ? "Suchaktionen" : "Search actions"}</dt><dd data-summary-actions>0</dd></div></dl>
        <p class="action-explanation" data-summary-relation></p>
      </section>
      <div class="query-selection" data-query-selection hidden>
        <p><strong data-selected-query-count>0</strong> {de ? "Queries ausgewählt" : "queries selected"}</p>
        <div><button type="button" data-select-all-queries>{de ? "Alle auswählen" : "Select all"}</button><button type="button" data-clear-query-selection>{de ? "Auswahl aufheben" : "Clear selection"}</button><button type="button" data-export-selected-json disabled>{de ? "Auswahl als JSON" : "Selected JSON"}</button><button type="button" data-export-selected-csv disabled>{de ? "Keyword-CSV" : "Keyword CSV"}</button></div>
      </div>
      <ol data-result-queries aria-label={copy.resultCount}></ol>
      <section class="result-sources" data-result-sources-section hidden><h3 data-result-sources-title>{copy.sources}</h3><p data-result-sources-note></p><ul data-result-sources></ul></section>
      <section class="result-cost" data-result-cost hidden><div><span>{de ? "VERBRAUCH DIESES LAUFS" : "THIS RUN'S USAGE"}</span><h3>{de ? "Tokens und geschätzte Kosten" : "Tokens and estimated cost"}</h3></div><dl><div><dt>{de ? "Input inkl. Suchkontext" : "Input incl. search context"}</dt><dd data-usage-input>–</dd></div><div><dt>Output-Tokens</dt><dd data-usage-output>–</dd></div><div><dt>{de ? "Suchaktionen" : "Search actions"}</dt><dd data-usage-searches>–</dd></div><div><dt>{de ? "Geschätzte Kosten" : "Estimated cost"}</dt><dd data-usage-cost>–</dd></div></dl><p class="usage-explanation">{de ? "Die Input-Zahl enthält bei OpenAI auch Web-Ergebnisse, die der Suchdienst dem Modell zum Lesen gibt. Keyword und Tool-Anweisung sind deutlich kürzer; OpenAI läuft bereits mit der kleinsten Kontextstufe „low“. Eine Suchaktion kann mehrere Query-Strings enthalten." : "For OpenAI, input includes web results passed to the model for reading. The keyword and tool instruction are much shorter; OpenAI already uses the smallest context setting, “low”. One search action can contain several query strings."}</p><p data-usage-basis></p><small>{de ? "Schätzung nach öffentlich gelisteten Preisen. Maßgeblich ist immer die Abrechnung des Providers." : "Estimate based on public list prices. Provider billing is authoritative."}</small></section>
      <section class="result-feedback" aria-labelledby={`result-feedback-title-${locale}`}>
        <div><h3 id={`result-feedback-title-${locale}`}>{de ? "War dieses Ergebnis hilfreich?" : "Was this result helpful?"}</h3><p>{de ? "Wir erfassen nur Ja oder Nein sowie Modus und Anbieter – ohne Keyword, Queries oder Quellen." : "We record only yes or no plus mode and provider — without the keyword, queries or sources."}</p></div>
        <div><button type="button" data-result-feedback="helpful">{de ? "Ja" : "Yes"}</button><button type="button" data-result-feedback="not_helpful">{de ? "Nein" : "No"}</button></div>
        <p data-feedback-status role="status" aria-live="polite"></p>
      </section>
      <section class="result-next" aria-labelledby={`result-next-title-${locale}`}>
        <div><span>{de ? "NÄCHSTER SCHRITT" : "NEXT STEP"}</span><h3 id={`result-next-title-${locale}`}>{de ? "Mach aus den Queries eine belastbare Entscheidung." : "Turn the queries into a defensible decision."}</h3><p>{de ? "Exportiere zuerst die beobachteten Queries als CSV. Entscheide danach, welche Seite ergänzt, neu gebaut oder verworfen wird." : "Export the observed queries as CSV first. Then decide which page to improve, create, or discard."}</p></div>
        <div class="next-actions"><a href="https://seo-fanout.com/?utm_source=ai-fanout.com&utm_medium=referral&utm_campaign=result_workflow" data-handoff="seo_fanout">{de ? "Queries in eine Seitenentscheidung übersetzen" : "Turn queries into a page decision"}<span aria-hidden="true">→</span></a><button type="button" data-contextter-export disabled>{de ? "Ausgewählte Queries als Keywordliste laden" : "Download selected queries as a keyword list"}<span aria-hidden="true">↓</span></button><a href={de ? "https://crawlfoundry.com/de/features/keyword-database?utm_source=ai-fanout.com&utm_medium=referral&utm_campaign=result_workflow" : "https://crawlfoundry.com/features/keyword-database?utm_source=ai-fanout.com&utm_medium=referral&utm_campaign=result_workflow"} data-handoff="contextter">{de ? "Keywordliste in Crawl Foundry weiterbearbeiten" : "Continue with the keyword list in Crawl Foundry"}<span aria-hidden="true">→</span></a></div>
        <p class="ownership-note">{de ? "ai-fanout.com, SEO Fanout und Crawl Foundry werden von Matthias Ramahi betrieben. Die Links bilden verbundene Arbeitsabläufe ab und sind keine unabhängigen Empfehlungen." : "ai-fanout.com, SEO Fanout and Crawl Foundry are operated by Matthias Ramahi. These links connect related workflows and are not independent recommendations."}</p>
      </section>
      <footer><p data-result-notice></p><span data-result-date></span></footer>
    </div>
  </dialog>

  <dialog class="loading-dialog" data-loading-dialog aria-labelledby={`fanout-loading-title-${locale}`}>
    <div class="loading-panel" aria-live="polite" aria-busy="true">
      <span class="loading-signal" aria-hidden="true"></span>
      <p>{de ? "LIVE API-LAUF" : "LIVE API RUN"}</p>
      <h2 id={`fanout-loading-title-${locale}`}>{copy.loadingTitle}</h2>
      <p class="loading-help">{copy.loadingHelp} <strong><span data-loading-seconds>0</span> s</strong></p>
      <div class="loading-track" data-loading-progress role="progressbar" aria-label={de ? "Websuche läuft" : "Web search in progress"}><span></span></div>
      <ol>{copy.loadingSteps.map((step, index) => <li data-loading-step={index}><span>{String(index + 1).padStart(2, "0")}</span><strong>{step}</strong></li>)}</ol>
    </div>
  </dialog>

  <section class="saved-history" data-saved-history aria-labelledby={`saved-history-title-${locale}`}>
    <header><div><p>{de ? "LOKALE HISTORIE" : "LOCAL HISTORY"}</p><h2 id={`saved-history-title-${locale}`}>{copy.savedTitle}</h2><small>{copy.savedHelp}</small></div><button type="button" data-clear-history hidden>{copy.clearSaved}</button></header>
    <p class="storage-status" data-storage-status>{de ? "Gespeicherte Ergebnisse bleiben auf diesem Gerät verfügbar, bis du sie löschst oder sie nach spätestens 30 Tagen automatisch entfernt werden." : "Saved results remain available on this device until you delete them or they are automatically removed after no more than 30 days."}</p>
    <p data-history-empty>{copy.savedEmpty}</p>
    <div class="history-tools" data-history-tools hidden><p><strong data-selected-count>0</strong> {de ? "Läufe ausgewählt" : "runs selected"}</p><div><button type="button" data-compare-runs disabled>{de ? "Vergleichen" : "Compare"}</button><button type="button" data-export-runs-json disabled>JSON</button><button type="button" data-export-runs-csv disabled>CSV</button></div></div>
    <ol data-history-list></ol>
  </section>

  <dialog class="comparison-dialog" data-comparison-dialog aria-labelledby={`comparison-title-${locale}`}>
    <div class="comparison-panel"><button type="button" class="modal-close" data-comparison-close><span aria-hidden="true">×</span><span>{copy.close}</span></button><header><p>{de ? "LOKALER VERGLEICH" : "LOCAL COMPARISON"}</p><h2 id={`comparison-title-${locale}`}>{de ? "Gespeicherte Läufe vergleichen" : "Compare saved runs"}</h2><strong data-comparison-type></strong><small>{de ? "Keine neue API-Anfrage. Exakte Query-Treffer werden erst hier im Browser berechnet; es ist kein unabhängiger Modellbenchmark." : "No new API call. Exact query matches are calculated here in your browser; this is not an independent model benchmark."}</small></header><div data-comparison-summary></div><div class="comparison-runs" data-comparison-runs></div></div>
  </dialog>
</section>
<script src="../scripts/fanout-planner.ts"></script>
<style>
  [hidden]{display:none!important}
  .mode-picker{display:grid;grid-template-columns:1fr 1fr;margin:0 0 1.25rem;padding:0;border:0}
  .mode-picker legend{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .mode-picker label{position:relative}.mode-picker input{position:absolute;opacity:0}
  .mode-picker span{display:grid;min-height:4.4rem;align-content:center;padding:.85rem 1rem;border:1px solid var(--rule);cursor:pointer}
  .mode-picker label+label span{border-left:0}.mode-picker strong{font-size:.9rem}.mode-picker small{margin-top:.35rem;color:var(--muted);font-size:.68rem;line-height:1.35}
  .mode-picker input:checked+span{border-color:var(--source);background:var(--source-soft);box-shadow:inset 0 -2px var(--source)}
  .mode-picker input:focus-visible+span{outline:2px solid var(--focus);outline-offset:3px}
  .example-topics{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;margin:.85rem 0 0}.example-topics>span{margin-right:.25rem;color:var(--muted);font:.61rem/1 var(--font-mono);text-transform:uppercase}.example-topics button{min-height:2.15rem;padding:.45rem .7rem;border:1px solid var(--fine-rule);background:transparent;color:var(--ink);font-size:.7rem;cursor:pointer}.example-topics button:hover,.example-topics button:focus-visible{border-color:var(--source);background:var(--source-soft);color:var(--source)}
  .native-picker,.modelled-picker{grid-template-columns:repeat(2,1fr)}
  .result-sources{grid-column:1/-1;padding:1.25rem 0;border-bottom:1px solid var(--rule)}
  .result-sources h3{margin:0 0 .85rem;color:var(--source);font:.65rem/1 var(--font-mono);text-transform:uppercase}
  .result-sources ul{display:grid;gap:.5rem;margin:0;padding:0;list-style:none}.result-sources a{color:var(--ink);font-size:.78rem;overflow-wrap:anywhere}
  .result-sources>p{margin:0 0 .85rem;color:var(--muted);font-size:.74rem;line-height:1.5}
  .result-reading{grid-column:1/-1;padding:1.5rem 0;border-block:1px solid var(--rule)}.reading-head{display:flex;justify-content:space-between;gap:1rem;align-items:end}.reading-head span,.result-cost>div span{color:var(--source);font:.62rem/1 var(--font-mono);letter-spacing:.08em}.reading-head h3,.result-cost h3{margin:.45rem 0 0;font-size:1.1rem}.reading-head p{margin:0;color:var(--muted);font-size:.68rem;line-height:1.5}.result-summary{display:grid;grid-template-columns:repeat(3,1fr);margin:1.25rem 0 0;border:1px solid var(--rule)}.result-summary div{padding:1rem}.result-summary div+div{border-left:1px solid var(--rule)}.result-summary dt,.result-cost dt{color:var(--muted);font:.62rem/1.3 var(--font-mono)}.result-summary dd{margin:.5rem 0 0;color:var(--ink);font:700 1.35rem/1 var(--font-display)}.action-explanation{margin:.65rem 0 0;color:var(--muted);font-size:.7rem;line-height:1.5}
  [data-result-queries] .query-sources{grid-column:3/-1;margin:.65rem 0 0;padding:.7rem;border-left:2px solid var(--source);background:var(--source-soft)}[data-result-queries] .query-sources p{margin:0 0 .45rem;color:var(--muted);font:.62rem/1.4 var(--font-mono)}[data-result-queries] .query-sources ul{display:flex;flex-wrap:wrap;gap:.45rem;margin:0;padding:0;list-style:none}[data-result-queries] .query-sources a{color:var(--ink);font-size:.7rem;overflow-wrap:anywhere}
  .query-selection{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.8rem 0;border-top:1px solid var(--rule)}.query-selection p{margin:0;font:.68rem/1 var(--font-mono)}.query-selection>div{display:flex;flex-wrap:wrap;gap:.45rem}.query-selection button,.next-actions button{min-height:2.7rem;padding:.65rem .8rem;border:1px solid var(--rule);background:transparent;color:var(--ink);font-size:.72rem;font-weight:650;cursor:pointer}.query-selection button:hover:not(:disabled),.next-actions button:hover:not(:disabled){border-color:var(--source);background:var(--source-soft)}.query-selection button:disabled,.next-actions button:disabled{opacity:.38;cursor:not-allowed}.query-choice{position:relative;display:grid;width:1.55rem;height:1.55rem;place-items:center}.query-choice input{position:absolute;width:1px;height:1px;opacity:0}.query-choice span{display:grid!important;width:1.05rem;height:1.05rem;place-items:center;border:1px solid var(--rule);background:var(--paper)}.query-choice input:checked+span{border-color:var(--source);background:var(--source)}.query-choice input:checked+span::after{width:.4rem;height:.22rem;border-bottom:2px solid #041014;border-left:2px solid #041014;content:"";transform:translateY(-.04rem) rotate(-45deg)}.query-choice input:focus-visible+span{outline:2px solid var(--focus);outline-offset:3px}
  .result-cost{grid-column:1/-1;display:grid;grid-template-columns:minmax(12rem,.8fr) 1.5fr;gap:1rem;padding:1.25rem 0;border-bottom:1px solid var(--rule)}.result-cost dl{display:grid;grid-template-columns:repeat(4,1fr);margin:0}.result-cost dl div{padding:.7rem;border-left:1px solid var(--fine-rule)}.result-cost dd{margin:.45rem 0 0;font:700 .85rem/1 var(--font-mono)}.result-cost>p,.result-cost>small{grid-column:1/-1;margin:0;color:var(--muted);font-size:.66rem;line-height:1.5}.result-cost>.usage-explanation{max-width:82ch;padding:.85rem 1rem;border-left:2px solid var(--source);background:var(--source-soft);color:#cbd3d6}.result-cost>small{color:var(--ink)}
  .result-actions .compare-provider{border-color:var(--source);color:var(--source)}.result-actions .compare-provider span+span{margin-left:.35rem}
  .result-feedback{grid-column:1/-1;display:grid;grid-template-columns:1fr auto;gap:.75rem 1.25rem;align-items:center;padding:1.15rem 0;border-bottom:1px solid var(--rule)}.result-feedback h3{margin:0;font-size:1rem}.result-feedback p{margin:.35rem 0 0;color:var(--muted);font-size:.72rem;line-height:1.5}.result-feedback>div:nth-child(2){display:flex;gap:.5rem}.result-feedback button{min-width:4.25rem;min-height:2.55rem;border:1px solid var(--rule);background:transparent;color:var(--ink);font-weight:700;cursor:pointer}.result-feedback button:hover:not(:disabled),.result-feedback button[aria-pressed="true"]{border-color:var(--source);background:var(--source-soft);color:var(--source)}.result-feedback button:disabled{cursor:default;opacity:.65}.result-feedback>[data-feedback-status]{grid-column:1/-1;margin:0;color:var(--source);font:.64rem/1.4 var(--font-mono)}
  .result-next{grid-column:1/-1;display:grid;grid-template-columns:minmax(15rem,.75fr) 1.25fr;gap:1.5rem;padding:1.5rem 0;border-bottom:1px solid var(--rule)}.result-next>div>span{color:var(--source);font:.62rem/1 var(--font-mono);letter-spacing:.08em}.result-next h3{margin:.5rem 0;font-size:1.2rem}.result-next p{margin:.45rem 0 0;color:var(--muted);font-size:.76rem;line-height:1.55}.next-actions{display:grid;gap:.65rem}.next-actions a,.next-actions button{display:flex;justify-content:space-between;gap:1rem;padding:1rem;border:1px solid var(--source);color:var(--ink);font-size:.82rem;font-weight:650;text-align:left;text-decoration:none}.next-actions a:hover{background:var(--source-soft)}.next-actions span{color:var(--source)}.result-next .ownership-note{grid-column:1/-1;margin:0;padding:.8rem 1rem;border-left:2px solid var(--signal);background:rgba(255,122,76,.05);font-size:.68rem}
  .loading-dialog{width:100%;max-width:none;height:100%;max-height:none;margin:0;padding:1rem;border:0;background:rgba(3,5,6,.92);color:var(--ink)}
  .loading-dialog::backdrop{background:rgba(3,5,6,.92)}
