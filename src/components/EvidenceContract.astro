---
interface Props{locale:"en"|"de"}
const {locale}=Astro.props;const de=locale==="de";
const rows=de?[
  ["Query-String aus Native Fanout","In diesem API-Lauf offengelegte Suchformulierung","Kein Suchvolumen, Ranking oder vollständiger Consumer-Trace"],
  ["Query-/Aktions-/Laufquelle","Quelle auf dem vom Response belegten Umfang","Keine individuelle Query-Zuordnung ohne entsprechende Verbindung"],
  ["Abgeschlossen, null sichtbare Queries","Der Lauf lieferte keine exponierten Query-Strings","Fehlende Felder werden nicht mit Suchideen aufgefüllt"],
  ["Suchideen-Ausgabe","Zehn modellierte Rechercherichtungen ohne Websuche","Keine beobachteten Provider-Suchen oder belegte Nachfrage"],
  ["Verbrauch und Kostenschätzung","Gemeldete Nutzung mit datierten Listenpreisen","Keine verbindliche Providerrechnung"],
  ["Freiwilliger lokaler Save","Bis zu 20 Läufe, höchstens 30 Tage, exakte Browser-Origin","Kein Account-Sync; Gemini-Grounding und Suchvorschläge entfernt"]
]:[
  ["Query string from Native Fanout","A search phrase exposed in this API run","No search volume, ranking or complete consumer trace"],
  ["Query/action/run source","A source at the scope supported by the response","No per-query attribution without a corresponding relationship"],
  ["Completed, zero visible queries","The run exposed no query strings","Missing fields are not filled with search ideas"],
  ["Search Ideas output","Ten modelled research directions without web search","No observed provider searches or established demand"],
  ["Usage and cost estimate","Reported usage evaluated with dated list prices","Not the provider's binding invoice"],
  ["Optional local save","Up to 20 runs, at most 30 days, exact browser origin","No account sync; Gemini grounding and search suggestions removed"]
];
---
<div class="evidence-contract"><h3>{de?"Welche Schlussfolgerung trägt jedes Feld?":"Which conclusion does each field support?"}</h3><div class="contract-scroll" role="region" aria-label={de?"Ausgabe- und Beweisvertrag":"Output and evidence contract"} tabindex="0"><table><thead><tr>{(de?["Feld oder Status","Zulässige Aussage","Grenze"]:["Field or status","Supported claim","Limit"]).map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{rows.map(row=><tr>{row.map((cell,i)=>i===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div><p>{de?"Illustrativer Fall: Ein abgeschlossener nativer Lauf ohne Query-Feld und ein fehlgeschlagener Request sind zwei unterschiedliche Zustände. Die Fehlermeldung eines Requests ist keine Null-Query-Beobachtung. Keine der beiden Ausgaben rechtfertigt automatisch eine neue Seite.":"Illustrative case: a completed native run without a query field and a failed request are different states. A request error is not a zero-query observation. Neither output automatically justifies a new page."}</p><p>{de?"Methoden-/Implementierungsprüfung: 10. Oktober 2026. Die datierten OpenAI-Beispiele behalten ihr ursprüngliches Beobachtungsdatum.":"Method/implementation review: 10 October 2026. Dated OpenAI examples retain their original observation dates."}</p><nav aria-label={de?"Primärquellen zum Vertrag":"Primary contract sources"}><a href="https://developers.openai.com/api/docs/guides/tools-web-search" rel="external">OpenAI Web search</a><a href="https://ai.google.dev/gemini-api/docs/interactions-overview" rel="external">Gemini Interactions</a><a href="https://github.com/lia-xim/ai-fanout.com/tree/codex/fanout-planner-v1/src/scripts" rel="external">{de?"Eigene Export- und History-Implementierung":"Owner export and history implementation"}</a></nav><p>{de?"Für eine Seitenentscheidung kannst du jetzt Queries clustern und die Frage mit Search Console prüfen.":"For a page decision, you can now cluster queries and check the question against Search Console."} <a href={de?"/de/lernen/fanout-queries-clustern":"/library/cluster-fanout-queries"}>{de?"Clustering-Arbeitsblatt öffnen":"Open the clustering worksheet"}</a>.</p></div>
<style>
:global(#evidence-contract){scroll-margin-top:7rem}.evidence-contract{margin:2rem 0}.evidence-contract h3{font-size:1.2rem;line-height:1.4}.contract-scroll{max-width:100%;overflow-x:auto}.contract-scroll:focus-visible{outline:2px solid var(--source);outline-offset:4px}.contract-scroll table{width:100%;border-collapse:collapse;font-size:.92rem;line-height:1.65}.contract-scroll th,.contract-scroll td{padding:1rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule)}.contract-scroll thead th{color:var(--source)}.contract-scroll tbody th{width:27%}.contract-scroll td{color:var(--muted)}.evidence-contract nav{display:flex;flex-wrap:wrap;gap:.6rem 1.5rem}.evidence-contract a{color:var(--source);text-underline-offset:.25rem}.evidence-contract nav a{padding-block:.4rem}@media(max-width:650px){.contract-scroll table{min-width:36rem}}
</style>
