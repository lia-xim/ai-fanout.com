---
interface Props{locale:"en"|"de"}
const {locale}=Astro.props;const de=locale==="de";
const paths=de?[
  {name:"Verstehen",input:"Du hast ein Thema und willst die Ergebnisarten unterscheiden.",output:"Du weißt, welche Aussage deine Beobachtung trägt.",links:[["/de/lernen/was-ist-ai-query-fanout","Query Fanout verstehen"],["/de/methode","Methode und Grenzen prüfen"]]},
  {name:"Ausführen",input:"Du willst einen passenden Lauf starten und weiterverwenden.",output:"Du hast einen klar beschrifteten Export für deine Aufgabe.",links:[["/de#tool","Kostenloses Tool öffnen"],["/de/lernen/fanout-queries-exportieren","Auswahl oder Lauf exportieren"]]},
  {name:"Auswerten",input:"Du hast Fragen gesammelt und willst über Content entscheiden.",output:"Du hast geprüfte Cluster und ein ausgefülltes Briefing.",links:[["/de/lernen/fanout-queries-clustern","Queries clustern"],["/de/lernen/fanout-queries-search-console","Nachfrage mit GSC prüfen"],["/de/lernen/content-brief-aus-fanout","Content-Brief erstellen"]]},
  {name:"Implementieren",input:"Du willst Ausgabetypen und Datenumfang in deinem Workflow erhalten.",output:"Du hast getesteten Parser-Code und einen passenden JSON-Vertrag.",links:[["/de/lernen/openai-queries-per-api-auslesen","OpenAI-Parser bauen"],["/de/lernen/gemini-queries-per-api-auslesen","Gemini-Parser bauen"],["/de/lernen/fanout-parser-testen","Offline-Testkit ausführen"]]}
]:[
  {name:"Understand",input:"You have a topic and need to distinguish the result types.",output:"You know which claim your observation supports.",links:[["/library/what-is-ai-query-fanout","Understand query fanout"],["/methodology","Review the method and limits"]]},
  {name:"Run",input:"You want to run the appropriate mode and reuse its output.",output:"You have a clearly labelled export for the task.",links:[["/#tool","Open the free tool"],["/library/export-fanout-queries","Export a selection or run"]]},
  {name:"Review",input:"You have questions and need to decide what content to change.",output:"You have reviewed clusters and a completed content brief.",links:[["/library/cluster-fanout-queries","Cluster queries"],["/library/fanout-queries-search-console","Check demand with GSC"],["/library/fanout-content-brief","Create a content brief"]]},
  {name:"Implement",input:"You need to preserve result types and data scope in your workflow.",output:"You have tested parser code and the appropriate JSON contract.",links:[["/library/extract-openai-search-queries","Build an OpenAI parser"],["/library/extract-gemini-search-queries","Build a Gemini parser"],["/library/test-fanout-parsers","Run the offline test kit"]]}
];
---
<section class="learning-paths section-pad section-rule" aria-labelledby="learning-paths-title"><header><h2 id="learning-paths-title">{de?"Vier Wege zu einem nutzbaren Ergebnis":"Four paths to a usable result"}</h2><p>{de?"Beginne dort, wo du gerade stehst. Jeder Weg nennt das Ausgangsmaterial und die Aufgabe, die du am Ende erledigt hast.":"Start where you are now. Each path names the starting material and the task you should be able to finish."}</p></header><div>{paths.map(path=><article><h3>{path.name}</h3><p>{path.input}</p><p><strong>{de?"Ergebnis: ":"Outcome: "}</strong>{path.output}</p><nav aria-label={path.name}>{path.links.map(([href,label])=><a href={href}>{label}</a>)}</nav></article>)}</div></section>
<style>
.learning-paths header{max-width:55rem}.learning-paths h2{scroll-margin-top:7rem;margin:0;font:700 clamp(1.8rem,3vw,2.8rem)/1.15 var(--font-display);letter-spacing:-.035em}.learning-paths header p{max-width:65ch;color:var(--muted);line-height:1.7}.learning-paths>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:2rem}.learning-paths article{min-width:0;padding:1.5rem;border:1px solid var(--rule);background:var(--surface)}.learning-paths h3{margin:0;font-size:1.2rem}.learning-paths article p{color:var(--muted);font-size:.95rem;line-height:1.7}.learning-paths nav{display:grid;gap:.5rem;margin-top:1rem}.learning-paths a{width:fit-content;padding-block:.4rem;color:var(--source);line-height:1.5;text-underline-offset:.25rem}.learning-paths a:focus-visible{outline:2px solid var(--source);outline-offset:4px}@media(max-width:700px){.learning-paths>div{grid-template-columns:1fr}}
</style>
