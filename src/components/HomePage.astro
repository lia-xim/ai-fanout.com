---
import ArrowIcon from "./ArrowIcon.astro";
import FanoutPlanner from "./FanoutPlanner.astro";
interface Props { locale: "en" | "de" }
const { locale } = Astro.props;
const de = locale === "de";
const learn = de ? "/de/lernen" : "/library";
const method = de ? "/de/methode" : "/methodology";
const examples = de ? "/de/beispiele" : "/examples";
const guide = (en: string, german: string) => de ? `/de/lernen/${german}` : `/library/${en}`;
const c = de ? {
  title: "AI Query Fanout", intro: "Sieh, welche Websuchen eine KI für dein Thema ausführt.", limit: "Kostenlos · streng limitiert",
  overviewLabel: "01 / ERGEBNIS", overviewTitle: "Aus einem Thema werden konkrete Suchanfragen und sichtbare Quellen.", overviewCopy: "Im nativen Modus startet OpenAI oder Gemini einen echten API-Lauf mit Websuche. Das Ergebnis zeigt nur Query-Strings und Quellen, die der Anbieter in diesem Lauf offenlegt. Fehlt eine Query, erfinden wir keine Ersatzliste.",
  facts: [["Eingabe", "Ein kurzes Thema", "Land und Sprache sind optional."], ["Ergebnis", "0–8 Query-Strings", "Genau so, wie die API sie zurückgibt."], ["Quellen", "Nur belegte Zuordnung", "Eine URL wird nur dann einer Query zugeordnet, wenn der Provider diese Verbindung liefert."], ["Historie", "Freiwillig und lokal", "Bis zu 20 Ergebnisse für 30 Tage auf diesem Gerät."]],
  processLabel: "02 / ABLAUF", processTitle: "Was nach dem Klick passiert.", processCopy: "Der Ablauf ist kurz und absichtlich begrenzt. Es gibt keinen offenen Agenten-Loop und keinen zweiten versteckten Modellaufruf.",
  process: [["01", "Eingabe prüfen", "Maximal 60 Zeichen, keine URL und kein Zusatzkontext."], ["02", "Anbieter aufrufen", "Der Server sendet die Anfrage direkt an OpenAI oder Gemini. Der API-Key bleibt auf dem Server."], ["03", "Websuche ausführen", "Der Anbieter entscheidet innerhalb des Limits, welche Suchanfragen für dieses Thema nötig sind."], ["04", "Sichtbare Daten zeigen", "Queries, Quellen, Tokenverbrauch und Zeitpunkt werden aus genau diesem Response aufbereitet."]],
  readLabel: "03 / ERGEBNIS LESEN", readTitle: "Drei Angaben, drei unterschiedliche Bedeutungen.", readCopy: "Das Ergebnis bleibt bei den Daten, die der Provider tatsächlich liefert. Es gibt keine nachträglichen Themenlabels und keine erfundene Deutung der Queries.",
  readItems: [["Query", "Wonach der Anbieter in diesem Lauf gesucht hat."], ["Quelle", "Welche URL im Response auftauchte. Das ist weder Ranking noch Empfehlung."], ["Suchaktion", "Ein API-Tool-Aufruf. Eine Suchaktion kann mehrere Query-Strings enthalten."]],
  seoLabel: "04 / FÜR SEO NUTZEN", seoTitle: "Nicht jede Query braucht eine neue Seite.", seoCopy: "Die Liste ist ein Recherchehinweis, kein Veröffentlichungsplan. Gruppiere zuerst nach dem Problem des Lesers. Danach reicht oft eine bessere Erklärung auf einer vorhandenen Seite.",
  decisions: [["Bestehende Seite ergänzen", "Wenn Zielgruppe, Thema und nächster Schritt gleich bleiben."], ["Neue Seite bauen", "Wenn die Query eine eigene Nutzeraufgabe, eigene Belege und eine klare nächste Entscheidung hat."], ["Erst recherchieren", "Wenn Quellen fehlen oder die Query nur eine Vermutung über Nachfrage liefert."], ["Ignorieren", "Wenn es nur eine Wortvariante, ein Ausreißer oder für dein Angebot irrelevant ist."]],
  modelLabel: "05 / OPENAI ODER GEMINI", modelTitle: "Zwei Anbieter können dasselbe Thema anders auffächern.", modelCopy: "Nutze für einen fairen Vergleich dasselbe Keyword, Land und dieselbe Sprache. Speichere beide Läufe auf dem Gerät und wähle sie danach gemeinsam aus. Der Vergleich löst keine neue API-Anfrage aus.", modelCta: "Modellvergleich verstehen",
  localeLabel: "06 / LAND UND SPRACHE", localeTitle: "Kontext verändert Wörter, Quellen und Marktbezug.", localeCopy: "Deutsch und Englisch sind nicht nur Übersetzungen voneinander. Auch das Land kann Produkte, Preise, Regeln oder lokale Anbieter verändern. Die Auswahl ist Kontext für den Provider, keine Garantie für ein bestimmtes Ergebnis.", localeCta: "Land und Sprache richtig testen",
  repeatLabel: "07 / SCHWANKUNGEN", repeatTitle: "Derselbe Begriff kann morgen andere Queries liefern.", repeatCopy: "Modelle, Suchindizes, verfügbare Seiten und Provider-Routing ändern sich. Dazu kommt normale Generierungsvarianz. Ein Lauf ist deshalb eine datierte Beobachtung, kein dauerhaftes Keyword-Set.", repeatCta: "Warum Ergebnisse schwanken",
  limitsLabel: "08 / KOSTEN UND DATEN", limitsTitle: "Die große Input-Zahl ist vor allem Suchkontext.", limitsCopy: "Bei OpenAI zählen auch Web-Ergebnisse, die der Suchdienst dem Modell zum Lesen gibt, zu den Input-Tokens. Dein Keyword und unser Prompt sind deutlich kürzer. Wir nutzen bereits den kleinsten Suchkontext „low“. Weniger Kontext wäre nur mit einer anderen, nicht mehr nativen Sucharchitektur realistisch.",
  limits: [["500", "maximale Output-Tokens"], ["20 s", "Timeout pro Lauf"], ["20", "kostenlose Läufe je Verbindung in 24 Stunden"], ["30 Tage", "maximale lokale Speicherdauer"]], privacyCopy: "Roh-Eingabe und Roh-Response werden nicht in der Datenbank von ai-fanout.com gespeichert. Nur wenn du aktiv speicherst, legt dein Browser das sichtbare Ergebnis lokal ab. Die Kostenanzeige ist eine Schätzung; die Provider-Abrechnung ist maßgeblich.",
  learnLabel: "09 / WEITERLESEN", learnTitle: "Kurze Erklärungen für die Fragen, die nach einem Lauf entstehen.", learnCopy: "Der Wissensbereich vertieft Begriffe, Quellen, Modellvergleiche, Schwankungen und SEO-Entscheidungen. Die datierten Beispiele zeigen echte, überprüfbare OpenAI-Läufe und bleiben als Belegseiten erhalten – ohne die Hauptnavigation zu überladen.", learnCta: "Zum Wissensbereich", examplesCta: "Datierte Beispiele ansehen", methodCta: "Methodik und Grenzen"
} : {
  title: "AI Query Fanout", intro: "See which web searches an AI runs for your topic.", limit: "Free · strictly limited",
  overviewLabel: "01 / OUTPUT", overviewTitle: "One topic becomes concrete search queries and visible sources.", overviewCopy: "In Native mode, OpenAI or Gemini runs a real API request with web search. The result contains only query strings and sources exposed by the provider in that run. If no query is exposed, we do not invent a substitute list.",
  facts: [["Input", "One short topic", "Country and language are optional."], ["Output", "0–8 query strings", "Shown as returned by the API."], ["Sources", "Only supported links", "A URL is linked to one query only when the provider sends that connection."], ["History", "Optional and local", "Up to 20 results for 30 days on this device."]],
  processLabel: "02 / PROCESS", processTitle: "What happens after you click.", processCopy: "The run is short and deliberately bounded. There is no open-ended agent loop and no second hidden model call.",
  process: [["01", "Validate the input", "Up to 60 characters, no URL and no extra context."], ["02", "Call one provider", "The server sends the request directly to OpenAI or Gemini. The API key stays server-side."], ["03", "Run web search", "Within the hard limit, the provider decides which searches the topic needs."], ["04", "Show exposed data", "Queries, sources, token use and time are prepared from that exact response."]],
  readLabel: "03 / READ THE RESULT", readTitle: "Three fields with three different meanings.", readCopy: "The result stays with data the provider actually returned. It adds no topic labels and does not invent an interpretation of the queries.",
  readItems: [["Query", "What the provider searched for in this run."], ["Source", "A URL present in the response. It is not a ranking or endorsement."], ["Search action", "One API tool call. One action can contain several query strings."]],
  seoLabel: "04 / USE IT FOR SEO", seoTitle: "Not every query needs a new page.", seoCopy: "The list is research input, not a publishing plan. Group the queries by the reader's job first. Often the best action is a clearer section on a page you already have.",
  decisions: [["Improve an existing page", "When the audience, topic and next step stay the same."], ["Create a new page", "When the query has its own user job, evidence and next decision."], ["Research first", "When sources are weak or the query is only a hypothesis about demand."], ["Ignore it", "When it is only a wording variant, an outlier or irrelevant to your offer."]],
  modelLabel: "05 / OPENAI OR GEMINI", modelTitle: "Two providers may branch the same topic differently.", modelCopy: "For a useful comparison, keep the keyword, country and language unchanged. Save both runs on the device and select them together. The comparison does not make another API request.", modelCta: "Understand model comparisons",
  localeLabel: "06 / COUNTRY AND LANGUAGE", localeTitle: "Context can change wording, sources and market focus.", localeCopy: "English and German runs are not merely translations. Country can also change products, prices, regulations or local providers. The setting gives the provider context; it cannot guarantee a particular result.", localeCta: "Test country and language",
  repeatLabel: "07 / VARIATION", repeatTitle: "The same topic may produce different queries tomorrow.", repeatCopy: "Models, search indexes, available pages and provider routing change. Normal generation variability also matters. A run is therefore a dated observation, not a permanent keyword set.", repeatCta: "Why results change",
  limitsLabel: "08 / COST AND DATA", limitsTitle: "The large input number is mostly search context.", limitsCopy: "For OpenAI, the web results passed to the model are counted as input tokens too. Your keyword and our instruction are much shorter. We already use the smallest search context setting, “low”. A much smaller input would require a different, no longer provider-native search architecture.",
  limits: [["500", "maximum output tokens"], ["20 s", "timeout per run"], ["20", "free runs per connection in 24 hours"], ["30 days", "maximum local retention"]], privacyCopy: "ai-fanout.com does not keep the raw input or raw provider response in its database. Only when you choose Save does your browser store the visible result locally. The cost shown is an estimate; provider billing is authoritative.",
  learnLabel: "09 / LEARN MORE", learnTitle: "Plain answers to the questions that follow a run.", learnCopy: "The learning area covers terms, sources, model comparisons, variation and SEO decisions. Dated examples preserve inspectable OpenAI observations as proof pages without crowding the main navigation.", learnCta: "Open the learning area", examplesCta: "Inspect dated examples", methodCta: "Method and limits"
};
---
<section class="tool-hero" id="tool"><header><h1>{c.title}</h1><div><p>{c.intro}</p><span>{c.limit}</span></div></header><FanoutPlanner locale={locale}/></section>
<section class="overview section-rule"><div class="overview-copy"><span class="section-number">{c.overviewLabel}</span><h2>{c.overviewTitle}</h2><p>{c.overviewCopy}</p></div><div class="branch-map" aria-hidden="true"><span>TOPIC</span><i></i><div>{Array.from({length:6}).map((_,index)=><b>{String(index+1).padStart(2,"0")}</b>)}</div></div><div class="fact-rail">{c.facts.map(item=><div><span>{item[0]}</span><strong>{item[1]}</strong><p>{item[2]}</p></div>)}</div></section>
<section class="process section-pad section-rule"><header><span class="section-number">{c.processLabel}</span><h2 class="section-title">{c.processTitle}</h2><p>{c.processCopy}</p></header><ol>{c.process.map(item=><li><span>{item[0]}</span><div><strong>{item[1]}</strong><p>{item[2]}</p></div></li>)}</ol></section>
<section class="reading section-pad section-rule"><header><span class="section-number">{c.readLabel}</span><h2 class="section-title">{c.readTitle}</h2><p>{c.readCopy}</p></header><dl>{c.readItems.map(item=><div><dt>{item[0]}</dt><dd>{item[1]}</dd></div>)}</dl></section>
<section class="seo-use section-pad section-rule"><div><span class="section-number">{c.seoLabel}</span><h2 class="section-title">{c.seoTitle}</h2><p>{c.seoCopy}</p><a class="text-action" href={guide("ai-query-fanout-for-seo","query-fanout-fuer-seo")}>{de ? "Fanout für SEO richtig nutzen" : "Use fanout for SEO"} <ArrowIcon/></a></div><ol>{c.decisions.map((item,index)=><li><span>{String(index+1).padStart(2,"0")}</span><div><strong>{item[0]}</strong><p>{item[1]}</p></div></li>)}</ol></section>
<section class="model section-pad section-rule"><div class="model-lines" aria-hidden="true"><span>OPENAI</span><i></i><b></b><i></i><span>GEMINI</span></div><div><span class="section-number">{c.modelLabel}</span><h2 class="section-title">{c.modelTitle}</h2><p>{c.modelCopy}</p><a class="text-action" href={guide("compare-ai-model-searches","ki-modelle-vergleichen")}>{c.modelCta} <ArrowIcon/></a></div></section>
<section class="paired section-rule"><article><span class="section-number">{c.localeLabel}</span><h2>{c.localeTitle}</h2><p>{c.localeCopy}</p><a class="text-action" href={guide("why-ai-fanout-results-change","warum-fanout-ergebnisse-schwanken")}>{c.localeCta} <ArrowIcon/></a></article><article><span class="section-number">{c.repeatLabel}</span><h2>{c.repeatTitle}</h2><p>{c.repeatCopy}</p><a class="text-action" href={guide("why-ai-fanout-results-change","warum-fanout-ergebnisse-schwanken")}>{c.repeatCta} <ArrowIcon/></a></article></section>
<section class="limits section-pad section-rule"><header><span class="section-number">{c.limitsLabel}</span><h2 class="section-title">{c.limitsTitle}</h2><p>{c.limitsCopy}</p></header><div class="limit-grid">{c.limits.map(item=><div><strong>{item[0]}</strong><span>{item[1]}</span></div>)}</div><p class="privacy-note">{c.privacyCopy}</p></section>
<section class="learn section-pad"><div><span class="section-number">{c.learnLabel}</span><h2 class="section-title">{c.learnTitle}</h2><p>{c.learnCopy}</p></div><nav aria-label={de ? "Mehr zum Tool" : "More about the tool"}><a href={learn}>{c.learnCta}<ArrowIcon/></a><a href={examples}>{c.examplesCta}<ArrowIcon/></a><a href={method}>{c.methodCta}<ArrowIcon/></a></nav></section>
<style>
.tool-hero{display:grid;align-content:center;min-height:calc(100dvh - 5.25rem);padding:clamp(2.5rem,5vw,5rem) var(--gutter);border-bottom:1px solid var(--rule)}.tool-hero>header{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(20rem,.55fr);gap:3rem;align-items:end;margin-bottom:clamp(2rem,4vw,3.5rem)}.tool-hero h1{margin:0;font:780 clamp(4.3rem,8vw,9rem)/.82 var(--font-display);letter-spacing:-.075em}.tool-hero>header p{max-width:34ch;margin:0;color:#c5cdd0;font-size:clamp(1.05rem,1.6vw,1.35rem);line-height:1.5}.tool-hero>header span{display:block;margin-top:1rem;color:var(--source);font:.68rem/1.4 var(--font-mono);text-transform:uppercase}
.tool-hero :global([data-planner-form]){padding:clamp(1.25rem,2.5vw,2.25rem);border:1px solid var(--rule);background:var(--surface)}.tool-hero :global(.query-line){display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.75rem 1.25rem;align-items:end}.tool-hero :global(.query-line>label){grid-column:1/-1;color:var(--muted);font:.65rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(.query-line>div){position:relative;min-width:0}.tool-hero :global(.query-line input){width:100%;min-height:4.8rem;padding:.7rem 5rem .7rem 1.15rem;border:1px solid var(--source);outline:0;background:#090d10;color:var(--ink);font:650 clamp(1.35rem,2.7vw,2.55rem)/1.1 var(--font-display)}.tool-hero :global(.query-line output){position:absolute;right:1rem;bottom:1rem;color:var(--muted);font:.61rem/1 var(--font-mono)}.tool-hero :global(.query-line button){display:flex;min-width:12rem;min-height:4.8rem;align-items:center;justify-content:space-between;gap:1.5rem;padding:0 1.35rem;border:1px solid var(--source);background:var(--source);color:#041014;font-weight:760;cursor:pointer}.tool-hero :global(.query-line button span){font-size:1.4rem}.tool-hero :global(button:disabled){cursor:not-allowed;opacity:.45}
.tool-hero :global(.model-picker){display:grid;grid-template-columns:repeat(3,1fr);margin:1.25rem 0 0;padding:0;border:0}.tool-hero :global(.model-picker legend){position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.tool-hero :global(.model-picker label){position:relative;display:block}.tool-hero :global(.model-picker label+label){border-left:1px solid var(--rule)}.tool-hero :global(.model-picker input){position:absolute;opacity:0;pointer-events:none}.tool-hero :global(.model-picker span){display:grid;grid-template-columns:1fr auto;gap:.4rem 1rem;min-height:4.8rem;align-content:center;padding:1rem 1.15rem;border-block:1px solid var(--rule);cursor:pointer;transition:background 160ms ease,border-color 160ms ease}.tool-hero :global(.model-picker label:first-of-type span){border-left:1px solid var(--rule)}.tool-hero :global(.model-picker label:last-of-type span){border-right:1px solid var(--rule)}.tool-hero :global(.model-picker strong){font-size:.92rem}.tool-hero :global(.model-picker small){grid-column:2;color:var(--muted);font:.59rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(.model-picker input:checked+span){border-color:var(--source);background:var(--source-soft);box-shadow:inset 0 -2px var(--source)}.tool-hero :global(.model-picker input:focus-visible+span){outline:2px solid var(--focus);outline-offset:3px}
.tool-hero :global(.tool-options){display:grid;grid-template-columns:1fr 1fr minmax(18rem,1fr);gap:1rem;margin-top:1rem}.tool-hero :global(.tool-options>label),.tool-hero :global(.human-check){display:grid;gap:.55rem;color:var(--muted);font:.62rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(select){width:100%;min-height:3.15rem;padding:.7rem .85rem;border:1px solid var(--rule);background:#0a0f12;color:var(--ink)}.tool-hero :global(.human-check>[data-turnstile-slot]){min-height:3.15rem;overflow:hidden}.tool-hero :global(.form-status),.tool-hero :global(.tool-disabled){min-height:1.2rem;margin:.85rem 0 0;color:var(--signal);font-size:.76rem;line-height:1.5}
.tool-hero :global(dialog){width:100%;max-width:none;height:100%;max-height:none;margin:0;padding:clamp(1rem,3vw,3rem);border:0;background:rgba(3,5,6,.92);color:var(--ink)}.tool-hero :global(dialog::backdrop){background:rgba(3,5,6,.92)}.tool-hero :global(.result-modal){position:relative;display:grid;grid-template-columns:1fr auto;max-width:86rem;max-height:calc(100dvh - 2rem);margin:auto;padding:clamp(1.25rem,2.5vw,2.25rem);overflow:auto;border:1px solid var(--source);background:var(--surface);box-shadow:0 2rem 8rem rgba(0,0,0,.65)}.tool-hero :global(.modal-close){position:sticky;z-index:2;top:0;grid-column:2;grid-row:1;display:flex;align-items:center;gap:.65rem;align-self:start;padding:.7rem .85rem;border:1px solid var(--rule);background:var(--surface);color:var(--ink);cursor:pointer}.tool-hero :global(.modal-close span:first-child){color:var(--source);font-size:1.5rem}.tool-hero :global(.result-title){grid-column:1;grid-row:1;padding-bottom:1.4rem}.tool-hero :global(.result-title p){margin:0 0 .65rem;color:var(--source);font:.63rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(.result-title h2){max-width:24ch;margin:0;font:730 clamp(2.5rem,5vw,5rem)/.92 var(--font-display);letter-spacing:-.055em}.tool-hero :global(.result-title strong){display:block;margin-top:1rem;color:var(--source);font-size:.9rem}.tool-hero :global(.result-meta){grid-column:1/-1;display:grid;grid-template-columns:.7fr .7fr 1.5fr;border-block:1px solid var(--rule)}.tool-hero :global(.result-meta div){padding:1rem}.tool-hero :global(.result-meta div+div){border-left:1px solid var(--fine-rule)}.tool-hero :global(.result-meta span){display:block;margin-bottom:.45rem;color:var(--source);font:.6rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(.result-meta b){font-size:.78rem;font-weight:550}.tool-hero :global(.result-actions){grid-column:1/-1;display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.75rem;padding:1rem 0}.tool-hero :global(.result-actions button){padding:.75rem 1rem;border:1px solid var(--source);background:transparent;color:var(--source);cursor:pointer}.tool-hero :global(.result-actions button:last-child){background:var(--source);color:#041014}.tool-hero :global([data-result-queries]){grid-column:1/-1;margin:0;padding:0;border-top:1px solid var(--rule);list-style:none}.tool-hero :global([data-result-queries] li){display:grid;grid-template-columns:3.5rem minmax(15rem,.9fr) minmax(18rem,1.1fr);gap:1.15rem;align-items:start;padding:1.1rem .75rem;border-bottom:1px solid var(--fine-rule)}.tool-hero :global([data-result-queries] li>span){color:var(--source);font:650 1.35rem/1 var(--font-mono)}.tool-hero :global([data-result-queries] strong){font-size:.95rem;line-height:1.4}.tool-hero :global([data-result-queries] div){display:grid;grid-template-columns:8rem 1fr;gap:1rem}.tool-hero :global([data-result-queries] div span){color:var(--source);font:.62rem/1.5 var(--font-mono);text-transform:uppercase}.tool-hero :global([data-result-queries] p){margin:0;color:var(--muted);font-size:.76rem;line-height:1.5}.tool-hero :global(.result-modal footer){grid-column:1/-1;display:flex;justify-content:space-between;gap:2rem;padding-top:1.2rem;color:var(--signal);font:.62rem/1.5 var(--font-mono)}.tool-hero :global(.result-modal footer p){max-width:70ch;margin:0}
.overview{position:relative;padding:clamp(5rem,9vw,9rem) var(--gutter)}.overview-copy{display:grid;grid-template-columns:.3fr 1fr .7fr;gap:clamp(2rem,6vw,7rem);align-items:start}.overview-copy .section-number{margin:0}.overview h2{max-width:14ch;margin:0;font:740 clamp(3.2rem,6.5vw,7rem)/.9 var(--font-display);letter-spacing:-.065em}.overview-copy>p{max-width:45ch;margin:0;color:var(--muted);line-height:1.75}.branch-map{display:grid;grid-template-columns:6rem 1fr minmax(20rem,.7fr);align-items:center;margin:clamp(4rem,7vw,7rem) 0}.branch-map>span{display:grid;height:5.5rem;place-items:center;border:1px solid var(--source);font:.62rem/1 var(--font-mono)}.branch-map>i{height:1px;background:var(--source)}.branch-map>div{display:grid;grid-template-columns:repeat(6,1fr);border-top:1px solid var(--source)}.branch-map b{position:relative;padding-top:1.7rem;color:var(--source);font:.62rem/1 var(--font-mono);font-weight:500}.branch-map b::before{position:absolute;top:0;left:0;width:1px;height:1.25rem;background:var(--source);content:""}.fact-rail{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--rule)}.fact-rail>div{padding:1.5rem 1.25rem}.fact-rail>div+div{border-left:1px solid var(--fine-rule)}.fact-rail span{color:var(--source);font:.62rem/1 var(--font-mono);text-transform:uppercase}.fact-rail strong{display:block;margin:1rem 0 .45rem}.fact-rail p{margin:0;color:var(--muted);font-size:.76rem;line-height:1.55}
.process{display:grid;grid-template-columns:minmax(20rem,.72fr) 1fr;gap:clamp(3rem,8vw,9rem)}.process header>p,.reading header>p,.seo-use>div>p,.model>div>p,.paired article>p,.limits header>p,.learn>div>p{max-width:58ch;color:var(--muted);line-height:1.7}.process ol,.seo-use ol{margin:0;padding:0;border-top:1px solid var(--rule);list-style:none}.process li,.seo-use li{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:1.3rem 0;border-bottom:1px solid var(--fine-rule)}.process li>span,.seo-use li>span{color:var(--source);font:.67rem/1.4 var(--font-mono)}.process li strong,.seo-use li strong{font-size:.95rem}.process li p,.seo-use li p{margin:.45rem 0 0;color:var(--muted);font-size:.8rem;line-height:1.55}
.reading{display:grid;grid-template-columns:1fr .85fr;gap:clamp(3rem,8vw,9rem);align-items:start}.reading dl{margin:0;border-top:1px solid var(--rule)}.reading dl>div{display:grid;grid-template-columns:minmax(8rem,.42fr) 1fr;gap:1.5rem;padding:1.25rem 0;border-bottom:1px solid var(--fine-rule)}.reading dt{color:var(--source);font:.7rem/1.4 var(--font-mono)}.reading dd{margin:0;color:#c8d0d3;font-size:.82rem;line-height:1.55}
.seo-use{display:grid;grid-template-columns:1fr minmax(22rem,.75fr);gap:clamp(3rem,8vw,9rem);align-items:start}.seo-use .text-action,.model .text-action,.paired .text-action{margin-top:1rem}
