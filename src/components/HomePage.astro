---
import ArrowIcon from "./ArrowIcon.astro";
import FanoutPlanner from "./FanoutPlanner.astro";
interface Props { locale: "en" | "de" }
const { locale } = Astro.props;
const de = locale === "de";
const learn = de ? "/de/lernen" : "/library";
const method = de ? "/de/methode" : "/methodology";
const examples = de ? "/de/beispiele" : "/examples";
const guide = (en: string, german: string) => de ? `/de/lernen/${german}` : `/library/${en}`;
const c = de ? {
  title: "Kostenloses AI Query Fanout Tool", intro: "Sieh, welche Websuchen OpenAI oder Gemini für dein Thema ausführt.", limit: "Ohne Anmeldung · 20 Läufe in 24 Stunden",
  overviewLabel: "01 / GRUNDLAGE", overviewTitle: "Warum sucht eine KI mehr als nur dein Keyword?", overviewCopy: ["Wenn du ChatGPT, Gemini oder einer anderen KI eine Frage stellst und sie dafür das Web durchsucht, kann aus deiner einen Frage eine Gruppe genauerer Suchen entstehen. Aus „Welche SEO-Tools passen zu kleinen Unternehmen?“ können zum Beispiel Suchen nach Preisen, Funktionen, Vergleichen und Erfahrungen werden. Diese Aufteilung nennt man AI Query Fanout.", "ai-fanout.com startet dafür einen begrenzten Websuchlauf über OpenAI oder Gemini. Du siehst anschließend nur die Suchanfragen und Quellen, die der gewählte Anbieter in genau diesem Lauf sichtbar macht. Das Tool schaut nicht in private Chat-Verläufe und behauptet nicht, jede interne Suche einer Chat-Oberfläche zu kennen."],
  exampleLabel: "Vereinfachtes Beispiel", exampleInput: "Welche SEO-Tools passen zu kleinen Unternehmen?", exampleQueries: ["SEO Tools für kleine Unternehmen", "SEO Tool Preise vergleichen", "einfache SEO Tools für Einsteiger", "SEO Tools für Keyword-Recherche"], exampleNote: "Ein möglicher Fanout zur Erklärung. Ein echter Lauf kann andere oder weniger Suchanfragen liefern.",
  facts: [["Start", "Ein Keyword oder eine kurze Frage", "Land und Sprache kannst du passend zu deinem Markt wählen."], ["AI Fanout", "Bis zu 8 sichtbare Suchanfragen", "Du siehst nur Suchanfragen, die OpenAI oder Gemini im Lauf offenlegt."], ["Quellen", "Webseiten hinter den Suchanfragen", "Eine Quelle wird nur dann mit einer Query verbunden, wenn der Anbieter diese Zuordnung mitliefert."], ["Speichern", "Freiwillig auf deinem Gerät", "Bis zu 20 Ergebnisse bleiben für höchstens 30 Tage verfügbar."]],
  processLabel: "02 / VON DER FRAGE ZUM FANOUT", processTitle: "So wird aus deiner Frage ein AI Fanout.", processCopy: "Der Ablauf folgt immer derselben verständlichen Kette: Du stellst eine Frage, das gewählte Modell zerlegt den Informationsbedarf, sucht im Web und zeigt dir die offengelegten Suchpfade.",
  process: [["01", "Thema eingeben", "Nutze ein Keyword oder eine kurze Frage mit höchstens 60 Zeichen."], ["02", "Modell auswählen", "Wähle OpenAI oder Gemini und ergänze bei Bedarf Land und Sprache."], ["03", "AI-Suche starten", "Das gewählte Modell entscheidet, welche Websuchen es für dein Thema benötigt."], ["04", "Fanout auswerten", "Prüfe die sichtbaren Suchanfragen, die verwendeten Quellen und die Angaben zum Lauf."]],
  readLabel: "03 / ERGEBNIS VERSTEHEN", readTitle: "Was zeigt das Fanout-Ergebnis wirklich?", readCopy: "Im Ergebnis stehen drei Arten von Informationen. Sie gehören zusammen, bedeuten aber nicht dasselbe: Die Suchanfrage zeigt das gesuchte Teilthema, die Quelle zeigt eine verwendete Webseite und die Suchaktion zählt den technischen Suchvorgang.",
  readItems: [["Suchanfrage", "Der konkrete Suchbegriff, den OpenAI oder Gemini in diesem Lauf offengelegt hat."], ["Quelle", "Eine Webseite, die im Ergebnis genannt wurde. Sie ist kein Ranking und keine automatische Empfehlung."], ["Suchaktion", "Ein Suchvorgang des Modells. Dabei können mehrere Suchanfragen zusammen ausgeführt werden."]],
  seoLabel: "04 / AI FANOUT FÜR SEO", seoTitle: "Vom AI Fanout zur besseren Seite.", seoCopy: "Ein Fanout zeigt neue Recherchewege, aber nicht jede Suchanfrage braucht eine eigene URL. Prüfe zuerst, welche Nutzerfrage dahintersteht und ob eine vorhandene Seite sie bereits sinnvoll beantworten kann.",
  decisions: [["Bestehende Seite ergänzen", "Wenn Zielgruppe, Thema und nächster Schritt gleich bleiben."], ["Neue Seite bauen", "Wenn die Query eine eigene Nutzeraufgabe, eigene Belege und eine klare nächste Entscheidung hat."], ["Erst recherchieren", "Wenn Quellen fehlen oder die Query nur eine Vermutung über Nachfrage liefert."], ["Ignorieren", "Wenn es nur eine Wortvariante, ein Ausreißer oder für dein Angebot irrelevant ist."]],
  handoffLabel: "05 / MIT DEN QUERIES WEITERARBEITEN", handoffTitle: "Dein Fanout ist der Anfang der SEO-Arbeit.", handoffCopy: "Die Queries zeigen mögliche Themen und Nutzerfragen. Ob daraus eine neue Seite, ein zusätzlicher Abschnitt oder gar keine Änderung entsteht, entscheidest du erst im nächsten Schritt.", handoffActions: [["Seitenentscheidung mit SEO Fanout vorbereiten", "Prüfe, welche Queries zusammengehören und welche konkrete Seitenaktion sinnvoll ist.", "https://seo-fanout.com/?utm_source=ai-fanout.com&utm_medium=referral&utm_campaign=homepage_workflow"], ["Keywords in Contextter weiterbearbeiten", "Importiere ausgewählte Queries, ordne sie in Listen und fordere Suchdaten nur dann an, wenn du sie brauchst.", "https://contextter.com/features/keyword-database?utm_source=ai-fanout.com&utm_medium=referral&utm_campaign=homepage_workflow"]], handoffDisclosure: "ai-fanout.com, SEO Fanout und Contextter werden von Matthias Ramahi betrieben. Die Links bilden einen gemeinsamen Arbeitsablauf ab und sind keine unabhängigen Empfehlungen.",
  modelLabel: "06 / MODELLE VERGLEICHEN", modelTitle: "OpenAI und Gemini erzeugen unterschiedliche Fanouts.", modelCopy: "Starte dasselbe Keyword mit gleichem Land und gleicher Sprache bei beiden Modellen. So kannst du vergleichen, welche Suchfragen und Quellen nur in einem Lauf oder in beiden Ergebnissen vorkommen.", modelCta: "AI-Fanout-Vergleich verstehen",
  localeLabel: "07 / LAND UND SPRACHE", localeTitle: "Land und Sprache verändern den AI Fanout.", localeCopy: "Ein deutscher und ein englischer Fanout sind nicht einfach Übersetzungen. Das gewählte Land kann außerdem andere Produkte, Preise, Regeln oder lokale Anbieter in den Vordergrund rücken.", localeCta: "Land und Sprache richtig testen",
  repeatLabel: "08 / FANOUT IM ZEITVERLAUF", repeatTitle: "Warum sich AI-Fanout-Queries verändern.", repeatCopy: "Suchergebnisse, verfügbare Webseiten und Modelle verändern sich. Auch zwei zeitnahe Läufe können deshalb unterschiedliche Suchanfragen liefern. Behandle jedes Ergebnis als Momentaufnahme, nicht als dauerhaftes Keyword-Set.", repeatCta: "Warum Fanout-Ergebnisse schwanken",
  limitsLabel: "09 / KOSTEN UND DATEN", limitsTitle: "AI Fanout kostenlos und kontrolliert testen.", limitsCopy: "Bei OpenAI zählen auch die gelesenen Web-Ergebnisse zu den Input-Tokens. Deshalb kann die Input-Zahl deutlich höher sein als dein Keyword. Die kostenlose Nutzung ist begrenzt, damit das Tool für alle verfügbar bleibt.",
  limits: [["500", "maximale Output-Tokens"], ["20 s", "Timeout pro Lauf"], ["20", "kostenlose Läufe je Verbindung in 24 Stunden"], ["30 Tage", "maximale lokale Speicherdauer"]], privacyCopy: "Deine Eingabe und das vollständige Ergebnis werden bei ai-fanout.com nicht dauerhaft gespeichert. Nur wenn du selbst auf Speichern klickst, bleibt das sichtbare Ergebnis auf deinem Gerät. Angezeigte Kosten sind Schätzwerte; entscheidend ist die Abrechnung des Anbieters.",
  learnLabel: "10 / AI FANOUT LERNEN", learnTitle: "AI Query Fanout verstehen und für SEO nutzen.", learnCopy: "Im Wissensbereich findest du ausführliche Erklärungen zu Fanout Queries, Quellen, Modellvergleichen, schwankenden Ergebnissen und sinnvollen SEO-Entscheidungen. Datierte Beispiele zeigen, wie einzelne Läufe tatsächlich aussehen.", learnCta: "AI Fanout lernen", examplesCta: "Fanout-Beispiele ansehen", methodCta: "So funktioniert das Tool"
} : {
  title: "Free AI Query Fanout Tool", intro: "See which web searches OpenAI or Gemini runs for your topic.", limit: "No signup · 20 runs in 24 hours",
  overviewLabel: "01 / THE IDEA", overviewTitle: "Why does an AI search for more than your keyword?", overviewCopy: ["When you ask ChatGPT, Gemini or another AI a question and it searches the web, your single question can become a group of narrower searches. “Which SEO tools suit a small business?” might lead to searches about pricing, features, comparisons and user experience. That split is called AI query fanout.", "ai-fanout.com runs a bounded web-search request through OpenAI or Gemini. It then shows only the queries and sources that the selected provider exposes in that run. The tool does not inspect private chats or claim to know every internal search made by a consumer chat interface."],
  exampleLabel: "Simplified example", exampleInput: "Which SEO tools suit a small business?", exampleQueries: ["SEO tools for small businesses", "compare SEO tool pricing", "easy SEO tools for beginners", "SEO tools for keyword research"], exampleNote: "One possible fanout for explanation. A real run may expose different or fewer searches.",
  facts: [["Start", "A keyword or short question", "Choose country and language to match your market."], ["AI fanout", "Up to 8 exposed searches", "You see only queries OpenAI or Gemini exposes in the run."], ["Sources", "Websites behind the searches", "A source is connected to a query only when the provider supplies that link."], ["Save", "Optional on your device", "Keep up to 20 results for no more than 30 days."]],
  processLabel: "02 / FROM QUESTION TO FANOUT", processTitle: "How your question becomes an AI fanout.", processCopy: "The run follows one clear chain: you ask a question, the selected model breaks down the information need, searches the web and shows the search paths it exposed.",
  process: [["01", "Enter a topic", "Use a keyword or short question of up to 60 characters."], ["02", "Choose a model", "Select OpenAI or Gemini and add country and language if useful."], ["03", "Start the AI search", "The selected model decides which web searches it needs for your topic."], ["04", "Review the fanout", "Inspect the exposed queries, cited sources and run details."]],
  readLabel: "03 / UNDERSTAND THE RESULT", readTitle: "What does a fanout result actually show?", readCopy: "The result contains three kinds of information. They belong together but mean different things: the query names the subtopic searched, the source names a website used, and the search action counts the search event.",
  readItems: [["Search query", "The exact search phrase OpenAI or Gemini exposed in this run."], ["Source", "A website named in the result. It is not a ranking or automatic recommendation."], ["Search action", "One model search event. It may include several queries at once."]],
  seoLabel: "04 / AI FANOUT FOR SEO", seoTitle: "Turn AI fanout into a better page.", seoCopy: "A fanout reveals new research paths, but not every query needs its own URL. First identify the user question behind it and check whether an existing page can already answer it well.",
  decisions: [["Improve an existing page", "When the audience, topic and next step stay the same."], ["Create a new page", "When the query has its own user job, evidence and next decision."], ["Research first", "When sources are weak or the query is only a hypothesis about demand."], ["Ignore it", "When it is only a wording variant, an outlier or irrelevant to your offer."]],
  handoffLabel: "05 / KEEP WORKING WITH THE QUERIES", handoffTitle: "Your fanout is the start of the SEO work.", handoffCopy: "The queries reveal possible topics and user questions. The next step is deciding whether they justify a new page, an additional section or no change at all.", handoffActions: [["Prepare a page decision with SEO Fanout", "Review which queries belong together and which page action makes sense.", "https://seo-fanout.com/?utm_source=ai-fanout.com&utm_medium=referral&utm_campaign=homepage_workflow"], ["Continue working with keywords in Contextter", "Import selected queries, organise them in lists and request search data only when you need it.", "https://contextter.com/features/keyword-database?utm_source=ai-fanout.com&utm_medium=referral&utm_campaign=homepage_workflow"]], handoffDisclosure: "ai-fanout.com, SEO Fanout and Contextter are operated by Matthias Ramahi. The links form one shared workflow and are not independent recommendations.",
  modelLabel: "06 / COMPARE MODELS", modelTitle: "OpenAI and Gemini create different fanouts.", modelCopy: "Run the same keyword with the same country and language in both models. You can then compare which search questions and sources appear in one result or both.", modelCta: "Understand AI fanout comparisons",
  localeLabel: "07 / COUNTRY AND LANGUAGE", localeTitle: "Country and language change the AI fanout.", localeCopy: "An English and a German fanout are not simply translations. The selected country can also bring different products, prices, rules or local providers into focus.", localeCta: "Test country and language",
  repeatLabel: "08 / FANOUT OVER TIME", repeatTitle: "Why AI fanout queries change.", repeatCopy: "Search results, available websites and models change over time. Even two nearby runs can therefore expose different searches. Treat each result as a dated snapshot, not a permanent keyword set.", repeatCta: "Why fanout results change",
  limitsLabel: "09 / COST AND DATA", limitsTitle: "Test AI fanout for free with clear limits.", limitsCopy: "For OpenAI, the web results read by the model also count as input tokens. That is why the input number can be much larger than your keyword. Free use is limited so the tool remains available to everyone.",
  limits: [["500", "maximum output tokens"], ["20 s", "timeout per run"], ["20", "free runs per connection in 24 hours"], ["30 days", "maximum local retention"]], privacyCopy: "ai-fanout.com does not permanently store your input or the full result. The visible result stays on your device only when you choose Save. Displayed costs are estimates; the provider's bill is final.",
  learnLabel: "10 / LEARN AI FANOUT", learnTitle: "Understand AI query fanout and use it for SEO.", learnCopy: "The learning area explains fanout queries, sources, model comparisons, changing results and practical SEO decisions. Dated examples show what individual runs actually look like.", learnCta: "Learn AI fanout", examplesCta: "View fanout examples", methodCta: "How the tool works"
};
---
<section class="tool-hero" id="tool"><header><h1>{c.title}</h1><div><p>{c.intro}</p><span>{c.limit}</span></div></header><FanoutPlanner locale={locale}/></section>
<section class="overview section-rule"><div class="overview-copy"><span class="section-number">{c.overviewLabel}</span><h2>{c.overviewTitle}</h2><div>{c.overviewCopy.map(paragraph=><p>{paragraph}</p>)}</div></div><div class="fanout-example"><div class="example-input"><span>{c.exampleLabel}</span><strong>{c.exampleInput}</strong></div><div class="example-branch" aria-hidden="true"><i></i><b></b><i></i></div><ol>{c.exampleQueries.map((query,index)=><li><span>{String(index+1).padStart(2,"0")}</span>{query}</li>)}</ol><p>{c.exampleNote}</p></div><div class="fact-rail">{c.facts.map(item=><div><span>{item[0]}</span><strong>{item[1]}</strong><p>{item[2]}</p></div>)}</div></section>
<section class="process section-pad section-rule"><header><span class="section-number">{c.processLabel}</span><h2 class="section-title">{c.processTitle}</h2><p>{c.processCopy}</p></header><ol>{c.process.map(item=><li><span>{item[0]}</span><div><strong>{item[1]}</strong><p>{item[2]}</p></div></li>)}</ol></section>
<section class="reading section-pad section-rule"><header><span class="section-number">{c.readLabel}</span><h2 class="section-title">{c.readTitle}</h2><p>{c.readCopy}</p></header><dl>{c.readItems.map(item=><div><dt>{item[0]}</dt><dd>{item[1]}</dd></div>)}</dl></section>
<section class="seo-use section-pad section-rule"><div><span class="section-number">{c.seoLabel}</span><h2 class="section-title">{c.seoTitle}</h2><p>{c.seoCopy}</p><a class="text-action" href={guide("ai-query-fanout-for-seo","query-fanout-fuer-seo")}>{de ? "Fanout für SEO richtig nutzen" : "Use fanout for SEO"} <ArrowIcon/></a></div><ol>{c.decisions.map((item,index)=><li><span>{String(index+1).padStart(2,"0")}</span><div><strong>{item[0]}</strong><p>{item[1]}</p></div></li>)}</ol></section>
<section class="handoff section-pad section-rule"><div><span class="section-number">{c.handoffLabel}</span><h2 class="section-title">{c.handoffTitle}</h2><p>{c.handoffCopy}</p><small>{c.handoffDisclosure}</small></div><nav aria-label={de ? "SEO-Workflow fortsetzen" : "Continue the SEO workflow"}>{c.handoffActions.map(item=><a href={item[2]} rel="external"><span><strong>{item[0]}</strong><small>{item[1]}</small></span><ArrowIcon/></a>)}</nav></section>
<section class="model section-pad section-rule"><div class="model-lines" aria-hidden="true"><span>OPENAI</span><i></i><b></b><i></i><span>GEMINI</span></div><div><span class="section-number">{c.modelLabel}</span><h2 class="section-title">{c.modelTitle}</h2><p>{c.modelCopy}</p><a class="text-action" href={guide("compare-ai-model-searches","ki-modelle-vergleichen")}>{c.modelCta} <ArrowIcon/></a></div></section>
<section class="paired section-rule"><article><span class="section-number">{c.localeLabel}</span><h2>{c.localeTitle}</h2><p>{c.localeCopy}</p><a class="text-action" href={guide("why-ai-fanout-results-change","warum-fanout-ergebnisse-schwanken")}>{c.localeCta} <ArrowIcon/></a></article><article><span class="section-number">{c.repeatLabel}</span><h2>{c.repeatTitle}</h2><p>{c.repeatCopy}</p><a class="text-action" href={guide("why-ai-fanout-results-change","warum-fanout-ergebnisse-schwanken")}>{c.repeatCta} <ArrowIcon/></a></article></section>
<section class="limits section-pad section-rule"><header><span class="section-number">{c.limitsLabel}</span><h2 class="section-title">{c.limitsTitle}</h2><p>{c.limitsCopy}</p></header><div class="limit-grid">{c.limits.map(item=><div><strong>{item[0]}</strong><span>{item[1]}</span></div>)}</div><p class="privacy-note">{c.privacyCopy}</p></section>
<section class="learn section-pad"><div><span class="section-number">{c.learnLabel}</span><h2 class="section-title">{c.learnTitle}</h2><p>{c.learnCopy}</p></div><nav aria-label={de ? "Mehr zum Tool" : "More about the tool"}><a href={learn}>{c.learnCta}<ArrowIcon/></a><a href={examples}>{c.examplesCta}<ArrowIcon/></a><a href={method}>{c.methodCta}<ArrowIcon/></a></nav></section>
<style>
.tool-hero{display:grid;align-content:center;min-height:calc(100dvh - 5.25rem);padding:clamp(2.5rem,5vw,5rem) var(--gutter);border-bottom:1px solid var(--rule)}.tool-hero>header{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(20rem,.55fr);gap:3rem;align-items:end;margin-bottom:clamp(2rem,4vw,3.5rem)}.tool-hero h1{margin:0;font:780 clamp(4.3rem,8vw,9rem)/.82 var(--font-display);letter-spacing:-.075em}.tool-hero>header p{max-width:34ch;margin:0;color:#c5cdd0;font-size:clamp(1.05rem,1.6vw,1.35rem);line-height:1.5}.tool-hero>header span{display:block;margin-top:1rem;color:var(--source);font:.68rem/1.4 var(--font-mono);text-transform:uppercase}
.tool-hero :global([data-planner-form]){padding:clamp(1.25rem,2.5vw,2.25rem);border:1px solid var(--rule);background:var(--surface)}.tool-hero :global(.query-line){display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.75rem 1.25rem;align-items:end}.tool-hero :global(.query-line>label){grid-column:1/-1;color:var(--muted);font:.65rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(.query-line>div){position:relative;min-width:0}.tool-hero :global(.query-line input){width:100%;min-height:4.8rem;padding:.7rem 5rem .7rem 1.15rem;border:1px solid var(--source);outline:0;background:#090d10;color:var(--ink);font:650 clamp(1.35rem,2.7vw,2.55rem)/1.1 var(--font-display)}.tool-hero :global(.query-line output){position:absolute;right:1rem;bottom:1rem;color:var(--muted);font:.61rem/1 var(--font-mono)}.tool-hero :global(.query-line button){display:flex;min-width:12rem;min-height:4.8rem;align-items:center;justify-content:space-between;gap:1.5rem;padding:0 1.35rem;border:1px solid var(--source);background:var(--source);color:#041014;font-weight:760;cursor:pointer}.tool-hero :global(.query-line button span){font-size:1.4rem}.tool-hero :global(button:disabled){cursor:not-allowed;opacity:.45}
.tool-hero :global(.model-picker){display:grid;grid-template-columns:repeat(3,1fr);margin:1.25rem 0 0;padding:0;border:0}.tool-hero :global(.model-picker legend){position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.tool-hero :global(.model-picker label){position:relative;display:block}.tool-hero :global(.model-picker label+label){border-left:1px solid var(--rule)}.tool-hero :global(.model-picker input){position:absolute;opacity:0;pointer-events:none}.tool-hero :global(.model-picker span){display:grid;grid-template-columns:1fr auto;gap:.4rem 1rem;min-height:4.8rem;align-content:center;padding:1rem 1.15rem;border-block:1px solid var(--rule);cursor:pointer;transition:background 160ms ease,border-color 160ms ease}.tool-hero :global(.model-picker label:first-of-type span){border-left:1px solid var(--rule)}.tool-hero :global(.model-picker label:last-of-type span){border-right:1px solid var(--rule)}.tool-hero :global(.model-picker strong){font-size:.92rem}.tool-hero :global(.model-picker small){grid-column:2;color:var(--muted);font:.59rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(.model-picker input:checked+span){border-color:var(--source);background:var(--source-soft);box-shadow:inset 0 -2px var(--source)}.tool-hero :global(.model-picker input:focus-visible+span){outline:2px solid var(--focus);outline-offset:3px}
.tool-hero :global(.tool-options){display:grid;grid-template-columns:1fr 1fr minmax(18rem,1fr);gap:1rem;margin-top:1rem}.tool-hero :global(.tool-options>label),.tool-hero :global(.human-check){display:grid;gap:.55rem;color:var(--muted);font:.62rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(select){width:100%;min-height:3.15rem;padding:.7rem .85rem;border:1px solid var(--rule);background:#0a0f12;color:var(--ink)}.tool-hero :global(.human-check>[data-turnstile-slot]){min-height:3.15rem;overflow:hidden}.tool-hero :global(.form-status),.tool-hero :global(.tool-disabled){min-height:1.2rem;margin:.85rem 0 0;color:var(--signal);font-size:.76rem;line-height:1.5}
.tool-hero :global(dialog){width:100%;max-width:none;height:100%;max-height:none;margin:0;padding:clamp(1rem,3vw,3rem);border:0;background:rgba(3,5,6,.92);color:var(--ink)}.tool-hero :global(dialog::backdrop){background:rgba(3,5,6,.92)}.tool-hero :global(.result-modal){position:relative;display:grid;grid-template-columns:1fr auto;max-width:86rem;max-height:calc(100dvh - 2rem);margin:auto;padding:clamp(1.25rem,2.5vw,2.25rem);overflow:auto;border:1px solid var(--source);background:var(--surface);box-shadow:0 2rem 8rem rgba(0,0,0,.65)}.tool-hero :global(.modal-close){position:sticky;z-index:2;top:0;grid-column:2;grid-row:1;display:flex;align-items:center;gap:.65rem;align-self:start;padding:.7rem .85rem;border:1px solid var(--rule);background:var(--surface);color:var(--ink);cursor:pointer}.tool-hero :global(.modal-close span:first-child){color:var(--source);font-size:1.5rem}.tool-hero :global(.result-title){grid-column:1;grid-row:1;padding-bottom:1.4rem}.tool-hero :global(.result-title p){margin:0 0 .65rem;color:var(--source);font:.63rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(.result-title h2){max-width:24ch;margin:0;font:730 clamp(2.5rem,5vw,5rem)/.92 var(--font-display);letter-spacing:-.055em}.tool-hero :global(.result-title strong){display:block;margin-top:1rem;color:var(--source);font-size:.9rem}.tool-hero :global(.result-meta){grid-column:1/-1;display:grid;grid-template-columns:.7fr .7fr 1.5fr;border-block:1px solid var(--rule)}.tool-hero :global(.result-meta div){padding:1rem}.tool-hero :global(.result-meta div+div){border-left:1px solid var(--fine-rule)}.tool-hero :global(.result-meta span){display:block;margin-bottom:.45rem;color:var(--source);font:.6rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(.result-meta b){font-size:.78rem;font-weight:550}.tool-hero :global(.result-actions){grid-column:1/-1;display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.75rem;padding:1rem 0}.tool-hero :global(.result-actions button){pa