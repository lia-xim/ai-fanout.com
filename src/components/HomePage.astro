---
import ArrowIcon from "./ArrowIcon.astro";
import FanoutPlanner from "./FanoutPlanner.astro";
interface Props { locale: "en" | "de" }
const { locale } = Astro.props;
const de = locale === "de";
const learn = de ? "/de/lernen" : "/library";
const method = de ? "/de/methode" : "/methodology";
const c = de ? {
  title: "AI Query Fanout", intro: "Mach aus einem Keyword zehn weiterführende Suchanfragen.", limit: "Kostenlos · 5 Läufe pro Tag", secondLabel: "WAS DU BEKOMMST", secondTitle: "Ein Modell baut einen nachvollziehbaren Suchplan rund um dein Thema.", secondCopy: "Du wählst GPT-5.6 Luna, DeepSeek V4 Flash oder Gemini 3.7 Flash. Das Modell liefert zehn unterschiedliche Suchrichtungen mit Intent und kurzer Begründung. Das Ergebnis ist eine Simulation – keine geheime Liste aus ChatGPT, Google oder einem Retrieval-System.", contract: [["Eingabe","Ein Keyword","Optional Land und Sprache."],["Ausgabe","10 Suchrichtungen","Jeweils mit Intent und Begründung."],["Modell","Du entscheidest","Ein Modell pro kostenlosem Lauf."],["Datenschutz","Keine Rohdaten-Speicherung","Keyword und Ergebnis bleiben flüchtig."]], learnLabel: "02 / WISSEN", learnTitle: "Query Fanout verstehen und sinnvoll für SEO nutzen.", learnCopy: "Klare Erklärungen zu Fanout, Modellen, Standort-Effekten, Schwankungen und der Frage, wann aus einer Suchrichtung wirklich eine Seite werden sollte.", learnCta: "Zum Wissensbereich", methodLabel: "TRANSPARENT GEMACHT", methodTitle: "Modellierte Suchrichtungen, keine versteckten Suchprotokolle.", methodCta: "Methodik und Grenzen"
} : {
  title: "AI Query Fanout", intro: "Turn one keyword into ten follow-up searches.", limit: "Free · 5 runs per day", secondLabel: "WHAT YOU GET", secondTitle: "One model builds a clear search plan around your topic.", secondCopy: "Choose GPT-5.6 Luna, DeepSeek V4 Flash or Gemini 3.7 Flash. The selected model returns ten distinct search directions with intent and a short reason. The result is a simulation — not a secret list from ChatGPT, Google or a retrieval system.", contract: [["Input","One keyword","Country and language are optional."],["Output","10 search directions","Each with intent and a short reason."],["Model","You choose","One model per free run."],["Privacy","No raw storage","Your keyword and result stay transient."]], learnLabel: "02 / LEARN", learnTitle: "Understand query fanout and use it carefully for SEO.", learnCopy: "Plain guides to fanout, models, location effects, variability and the point at which a search direction deserves a page — or does not.", learnCta: "Explore the guides", methodLabel: "MADE TRANSPARENT", methodTitle: "Modelled search directions, not hidden search logs.", methodCta: "Method and limits"
};
---
<section class="tool-hero" id="tool"><header><h1>{c.title}</h1><div><p>{c.intro}</p><span>{c.limit}</span></div></header><FanoutPlanner locale={locale}/></section>
<section class="explanation-hero section-rule"><span>{c.secondLabel}</span><h2>{c.secondTitle}</h2><p>{c.secondCopy}</p><div class="branch-mark" aria-hidden="true"><i></i>{Array.from({length:10}).map(()=><b></b>)}</div></section>
<section class="contract">{c.contract.map(item => <div><span>{item[0]}</span><strong>{item[1]}</strong><p>{item[2]}</p></div>)}</section>
<section class="secondary section-pad section-rule"><div><span class="section-number">{c.learnLabel}</span><h2 class="section-title">{c.learnTitle}</h2><p>{c.learnCopy}</p><a class="text-action" href={learn}>{c.learnCta} <ArrowIcon/></a></div><div class="steps"><span>{de ? "KEYWORD" : "KEYWORD"}</span><i></i><span>MODEL</span><i></i><span>10 QUERIES</span></div></section>
<section class="method section-pad"><p>{c.methodLabel}</p><h2>{c.methodTitle}</h2><a href={method}>{c.methodCta} <ArrowIcon/></a></section>
<style>
.tool-hero{display:grid;align-content:center;min-height:calc(100dvh - 5.25rem);padding:clamp(2.5rem,5vw,5rem) var(--gutter);border-bottom:1px solid var(--rule)}.tool-hero>header{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(20rem,.55fr);gap:3rem;align-items:end;margin-bottom:clamp(2rem,4vw,3.5rem)}.tool-hero h1{margin:0;font:780 clamp(4.3rem,8vw,9rem)/.82 var(--font-display);letter-spacing:-.075em}.tool-hero>header p{max-width:34ch;margin:0;color:#c5cdd0;font-size:clamp(1.05rem,1.6vw,1.35rem);line-height:1.5}.tool-hero>header span{display:block;margin-top:1rem;color:var(--source);font:.68rem/1.4 var(--font-mono);text-transform:uppercase}
.tool-hero :global([data-planner-form]){padding:clamp(1.25rem,2.5vw,2.25rem);border:1px solid var(--rule);background:var(--surface)}.tool-hero :global(.query-line){display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.75rem 1.25rem;align-items:end}.tool-hero :global(.query-line>label){grid-column:1/-1;color:var(--muted);font:.65rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(.query-line>div){position:relative;min-width:0}.tool-hero :global(.query-line input){width:100%;min-height:4.8rem;padding:.7rem 5rem .7rem 1.15rem;border:1px solid var(--source);outline:0;background:#090d10;color:var(--ink);font:650 clamp(1.35rem,2.7vw,2.55rem)/1.1 var(--font-display)}.tool-hero :global(.query-line output){position:absolute;right:1rem;bottom:1rem;color:var(--muted);font:.61rem/1 var(--font-mono)}.tool-hero :global(.query-line button){display:flex;min-width:12rem;min-height:4.8rem;align-items:center;justify-content:space-between;gap:1.5rem;padding:0 1.35rem;border:1px solid var(--source);background:var(--source);color:#041014;font-weight:760;cursor:pointer}.tool-hero :global(.query-line button span){font-size:1.4rem}.tool-hero :global(button:disabled){cursor:not-allowed;opacity:.45}
.tool-hero :global(.model-picker){display:grid;grid-template-columns:repeat(3,1fr);margin:1.25rem 0 0;padding:0;border:0}.tool-hero :global(.model-picker legend){position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.tool-hero :global(.model-picker label){position:relative;display:block}.tool-hero :global(.model-picker label+label){border-left:1px solid var(--rule)}.tool-hero :global(.model-picker input){position:absolute;opacity:0;pointer-events:none}.tool-hero :global(.model-picker span){display:grid;grid-template-columns:1fr auto;gap:.4rem 1rem;min-height:4.8rem;align-content:center;padding:1rem 1.15rem;border-block:1px solid var(--rule);cursor:pointer;transition:background 160ms ease,border-color 160ms ease}.tool-hero :global(.model-picker label:first-of-type span){border-left:1px solid var(--rule)}.tool-hero :global(.model-picker label:last-of-type span){border-right:1px solid var(--rule)}.tool-hero :global(.model-picker strong){font-size:.92rem}.tool-hero :global(.model-picker small){grid-column:2;color:var(--muted);font:.59rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(.model-picker input:checked+span){border-color:var(--source);background:var(--source-soft);box-shadow:inset 0 -2px var(--source)}.tool-hero :global(.model-picker input:focus-visible+span){outline:2px solid var(--focus);outline-offset:3px}
.tool-hero :global(.tool-options){display:grid;grid-template-columns:1fr 1fr minmax(18rem,1fr);gap:1rem;margin-top:1rem}.tool-hero :global(.tool-options>label),.tool-hero :global(.human-check){display:grid;gap:.55rem;color:var(--muted);font:.62rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(select){width:100%;min-height:3.15rem;padding:.7rem .85rem;border:1px solid var(--rule);background:#0a0f12;color:var(--ink)}.tool-hero :global(.human-check>[data-turnstile-slot]){min-height:3.15rem;overflow:hidden}.tool-hero :global(.form-status),.tool-hero :global(.tool-disabled){min-height:1.2rem;margin:.85rem 0 0;color:var(--signal);font-size:.76rem;line-height:1.5}
.tool-hero :global(dialog){width:100%;max-width:none;height:100%;max-height:none;margin:0;padding:clamp(1rem,3vw,3rem);border:0;background:rgba(3,5,6,.92);color:var(--ink)}.tool-hero :global(dialog::backdrop){background:rgba(3,5,6,.92)}.tool-hero :global(.result-modal){position:relative;display:grid;grid-template-columns:1fr auto;max-width:86rem;max-height:calc(100dvh - 2rem);margin:auto;padding:clamp(1.25rem,2.5vw,2.25rem);overflow:auto;border:1px solid var(--source);background:var(--surface);box-shadow:0 2rem 8rem rgba(0,0,0,.65)}.tool-hero :global(.modal-close){position:sticky;z-index:2;top:0;grid-column:2;grid-row:1;display:flex;align-items:center;gap:.65rem;align-self:start;padding:.7rem .85rem;border:1px solid var(--rule);background:var(--surface);color:var(--ink);cursor:pointer}.tool-hero :global(.modal-close span:first-child){color:var(--source);font-size:1.5rem}.tool-hero :global(.result-title){grid-column:1;grid-row:1;padding-bottom:1.4rem}.tool-hero :global(.result-title p){margin:0 0 .65rem;color:var(--source);font:.63rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(.result-title h2){max-width:24ch;margin:0;font:730 clamp(2.5rem,5vw,5rem)/.92 var(--font-display);letter-spacing:-.055em}.tool-hero :global(.result-title strong){display:block;margin-top:1rem;color:var(--source);font-size:.9rem}.tool-hero :global(.result-meta){grid-column:1/-1;display:grid;grid-template-columns:.7fr .7fr 1.5fr;border-block:1px solid var(--rule)}.tool-hero :global(.result-meta div){padding:1rem}.tool-hero :global(.result-meta div+div){border-left:1px solid var(--fine-rule)}.tool-hero :global(.result-meta span){display:block;margin-bottom:.45rem;color:var(--source);font:.6rem/1 var(--font-mono);text-transform:uppercase}.tool-hero :global(.result-meta b){font-size:.78rem;font-weight:550}.tool-hero :global(.result-actions){grid-column:1/-1;display:flex;justify-content:flex-end;gap:.75rem;padding:1rem 0}.tool-hero :global(.result-actions button){padding:.75rem 1rem;border:1px solid var(--source);background:transparent;color:var(--source);cursor:pointer}.tool-hero :global(.result-actions button:last-child){background:var(--source);color:#041014}.tool-hero :global([data-result-queries]){grid-column:1/-1;margin:0;padding:0;border-top:1px solid var(--rule);list-style:none}.tool-hero :global([data-result-queries] li){display:grid;grid-template-columns:3.5rem minmax(15rem,.9fr) minmax(18rem,1.1fr);gap:1.15rem;align-items:start;padding:1.1rem .75rem;border-bottom:1px solid var(--fine-rule)}.tool-hero :global([data-result-queries] li>span){color:var(--source);font:650 1.35rem/1 var(--font-mono)}.tool-hero :global([data-result-queries] strong){font-size:.95rem;line-height:1.4}.tool-hero :global([data-result-queries] div){display:grid;grid-template-columns:8rem 1fr;gap:1rem}.tool-hero :global([data-result-queries] div span){color:var(--source);font:.62rem/1.5 var(--font-mono);text-transform:uppercase}.tool-hero :global([data-result-queries] p){margin:0;color:var(--muted);font-size:.76rem;line-height:1.5}.tool-hero :global(.result-modal footer){grid-column:1/-1;display:flex;justify-content:space-between;gap:2rem;padding-top:1.2rem;color:var(--signal);font:.62rem/1.5 var(--font-mono)}.tool-hero :global(.result-modal footer p){max-width:70ch;margin:0}
.explanation-hero{position:relative;display:grid;grid-template-columns:.28fr 1fr .72fr;gap:clamp(2rem,6vw,7rem);align-items:start;padding:clamp(5rem,9vw,9rem) var(--gutter);overflow:hidden}.explanation-hero>span{color:var(--source);font:.65rem/1.4 var(--font-mono)}.explanation-hero h2{max-width:14ch;margin:0;font:740 clamp(3.2rem,6.5vw,7rem)/.9 var(--font-display);letter-spacing:-.065em}.explanation-hero p{max-width:45ch;margin:0;color:var(--muted);font-size:1rem;line-height:1.7}.branch-mark{position:absolute;right:var(--gutter);bottom:1.5rem;left:calc(var(--gutter) + 28%);display:grid;grid-template-columns:repeat(10,1fr);height:2.5rem}.branch-mark i{position:absolute;top:0;right:0;left:0;height:1px;background:var(--source)}.branch-mark b{position:relative;border-left:1px solid var(--source)}.branch-mark b::before{position:absolute;top:-3px;left:-3px;width:5px;height:5px;border:1px solid var(--source);border-radius:50%;background:var(--paper);content:""}
.contract{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--rule)}.contract div{padding:2rem var(--gutter)}.contract div+div{border-left:1px solid var(--fine-rule)}.contract span{color:var(--source);font:.62rem/1 var(--font-mono);text-transform:uppercase}.contract strong{display:block;margin:1.2rem 0 .5rem}.contract p{margin:0;color:var(--muted);font-size:.75rem;line-height:1.5}.secondary{display:grid;grid-template-columns:1fr minmax(25rem,.8fr);gap:5rem;align-items:center}.secondary p{max-width:55ch;color:var(--muted);line-height:1.65}.steps{display:grid;grid-template-columns:auto 1fr auto 1fr auto;align-items:center}.steps span{display:grid;width:6rem;height:6rem;place-items:center;border:1px solid var(--rule);font:.6rem/1 var(--font-mono)}.steps i{height:1px;background:var(--source)}.method{display:grid;grid-template-columns:.35fr 1fr auto;gap:3rem;align-items:end}.method>p{color:var(--source);font:.65rem/1.4 var(--font-mono);text-transform:uppercase}.method h2{margin:0;font:700 clamp(2.5rem,5vw,5rem)/.96 var(--font-display);letter-spacing:-.055em}.method a{display:inline-flex;gap:.7rem;padding:.9rem;border:1px solid var(--rule);font-size:.78rem;text-decoration:none}
@media(max-width:1050px){.tool-hero{min-height:0}.tool-hero>header,.explanation-hero,.secondary,.method{grid-template-columns:1fr}.tool-hero :global(.tool-options){grid-template-columns:1fr 1fr}.tool-hero :global(.human-check){grid-column:1/-1}.explanation-hero p{max-width:55ch}.branch-mark{left:var(--gutter)}.contract{grid-template-columns:1fr 1fr}.contract div:nth-child(3){border-left:0;border-top:1px solid var(--fine-rule)}.contract div:nth-child(4){border-top:1px solid var(--fine-rule)}}
@media(max-width:680px){.tool-hero{padding-block:3rem}.tool-hero h1{font-size:clamp(3.2rem,17vw,5.6rem)}.tool-hero>header{gap:1.25rem}.tool-hero :global(.query-line){grid-template-columns:1fr}.tool-hero :global(.query-line button){width:100%;min-height:3.8rem}.tool-hero :global(.model-picker){grid-template-columns:1fr}.tool-hero :global(.model-picker label+label){border-left:0}.tool-hero :global(.model-picker span){min-height:3.8rem;border-inline:1px solid var(--rule);border-top:0}.tool-hero :global(.model-picker label:first-of-type span){border-top:1px solid var(--rule)}.tool-hero :global(.tool-options){grid-template-columns:1fr}.tool-hero :global(.human-check){grid-column:auto}.tool-hero :global(dialog){padding:.5rem}.tool-hero :global(.result-modal){display:block;max-height:calc(100dvh - 1rem);padding:1rem}.tool-hero :global(.modal-close){float:right}.tool-hero :global(.result-title){padding-top:3.5rem}.tool-hero :global(.result-meta){grid-template-columns:1fr}.tool-hero :global(.result-meta div+div){border-top:1px solid var(--fine-rule);border-left:0}.tool-hero :global([data-result-queries] li){grid-template-columns:2.6rem 1fr}.tool-hero :global([data-result-queries] li>div){grid-column:2;grid-template-columns:1fr}.tool-hero :global(.result-modal footer){display:grid}.explanation-hero h2{font-size:clamp(3rem,14vw,5.2rem)}.contract{grid-template-columns:1fr}.contract div+div,.contract div:nth-child(3){border-top:1px solid var(--fine-rule);border-left:0}.steps span{width:4.7rem;height:4.7rem}}
</style>
