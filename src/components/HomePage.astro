---
import ArrowIcon from "./ArrowIcon.astro";
import FanoutPlanner from "./FanoutPlanner.astro";
interface Props { locale: "en" | "de" }
const { locale } = Astro.props;
const de = locale === "de";
const learn = de ? "/de/lernen" : "/library";
const method = de ? "/de/methode" : "/methodology";
const c = de ? {
  title: "Ein Keyword.", accent: "Die Suchanfragen dahinter.", intro: "Das kostenlose Tool führt eine begrenzte OpenAI-Websuche aus. Du siehst die Suchanfragen und Websites, die der API-Response für genau diesen Lauf offenlegt.", cta: "Kostenloses Tool öffnen", example: "Beispiel eines Fanouts", caveat: "API-Beobachtung, keine geheime Spur", origin: "DEIN\nKEYWORD", examples: ["beste SEO Tools", "SEO Software Vergleich", "SEO Tool für Agenturen", "günstige SEO Tools", "SEO Tools mit GSC"], toolLabel: "01 / KOSTENLOSES TOOL", toolTitle: "Keyword eingeben. Fanout sehen.", toolCopy: "Wähle optional Land und Sprache. Das Tool zeigt nur Suchanfragen, die im API-Response stehen. Fehlen sie dort, erfindet es keine.", contract: [["Du gibst ein","Ein Keyword","Optional Land und Sprache."],["Du bekommst","Beobachtete Suchanfragen","Nur offen gelegte API-Suchaktionen."],["Zusätzlich","Verwendete Websites","Sichtbare Quellen aus demselben Lauf."],["Datenschutz","Keine Rohdaten-Speicherung","Keyword und Ergebnis werden nicht gespeichert."]], learnLabel: "02 / LERNEN", learnTitle: "Verstehen, was hinter dem Ergebnis steckt.", learnCopy: "Kurze, klare Erklärungen zu Query Fanout, OpenAI-Websuche, Quellen, Schwankungen und SEO-Nutzung.", learnCta: "Zum Wissensbereich", methodLabel: "KLARE GRENZEN", methodTitle: "Keine Browser-Tricks. Keine Gedankenprotokolle. Nur Daten, die der Anbieter im API-Response offenlegt.", methodCta: "So funktioniert das Tool"
} : {
  title: "One keyword.", accent: "The searches behind it.", intro: "The free tool runs one bounded OpenAI web search. You see the search queries and websites exposed in the API response for that specific run.", cta: "Open the free tool", example: "Example fanout", caveat: "API observation, not a hidden trace", origin: "YOUR\nKEYWORD", examples: ["best SEO tools", "SEO software comparison", "SEO tool for agencies", "affordable SEO tools", "SEO tools with GSC"], toolLabel: "01 / FREE TOOL", toolTitle: "Enter a keyword. See the fanout.", toolCopy: "Optionally choose a country and language. The tool shows only queries present in the API response. If they are missing, it does not make them up.", contract: [["You enter","One keyword","Country and language are optional."],["You get","Observed search queries","Only provider-exposed API actions."],["Also included","Websites used","Visible sources from the same run."],["Privacy","No raw storage","The keyword and result are not stored."]], learnLabel: "02 / LEARN", learnTitle: "Understand what sits behind the result.", learnCopy: "Clear guides to query fanout, OpenAI web search, citations, result changes and practical SEO use.", learnCta: "Explore the guides", methodLabel: "CLEAR BOUNDARIES", methodTitle: "No browser tricks. No thought logs. Only data the provider exposes in its API response.", methodCta: "See how the tool works"
};
---
<section class="planner-hero"><div><h1>{c.title}<br/><span>{c.accent}</span></h1><p>{c.intro}</p><a class="button" href="#tool">{c.cta} <ArrowIcon/></a><ul><li>{de ? "Kostenlos" : "Free"}</li><li>{de ? "OpenAI zuerst" : "OpenAI first"}</li><li>{de ? "Keine Rohdaten-Speicherung" : "No raw storage"}</li></ul></div><figure><figcaption><span>{c.example}</span><small>{c.caveat}</small></figcaption><div class="origin">{c.origin.split("\n").map(line => <>{line}<br/></>)}</div><ol>{c.examples.map(item => <li>{item}</li>)}</ol></figure></section>
<div id="tool" class="planner-stage"><header><span>{c.toolLabel}</span><h2>{c.toolTitle}</h2><p>{c.toolCopy}</p></header><FanoutPlanner locale={locale}/></div>
<section class="contract">{c.contract.map(item => <div><span>{item[0]}</span><strong>{item[1]}</strong><p>{item[2]}</p></div>)}</section>
<section class="secondary section-pad section-rule"><div><span class="section-number">{c.learnLabel}</span><h2 class="section-title">{c.learnTitle}</h2><p>{c.learnCopy}</p><a class="text-action" href={learn}>{c.learnCta} <ArrowIcon/></a></div><div class="steps"><span>{de ? "EINGABE" : "INPUT"}</span><i></i><span>QUERIES</span><i></i><span>{de ? "QUELLEN" : "SOURCES"}</span></div></section>
<section class="method section-pad"><p>{c.methodLabel}</p><h2>{c.methodTitle}</h2><a href={method}>{c.methodCta} <ArrowIcon/></a></section>
<style>
.planner-hero{display:grid;grid-template-columns:minmax(25rem,.92fr) minmax(30rem,1.08fr);gap:clamp(3rem,8vw,9rem);align-items:center;min-height:calc(100dvh - 5.25rem);padding:clamp(4rem,8vw,8rem) var(--gutter);border-bottom:1px solid var(--rule)}.planner-hero h1{margin:0;font:780 clamp(4.2rem,7.5vw,8.6rem)/.84 var(--font-display);letter-spacing:-.08em}.planner-hero h1 span{color:var(--source)}.planner-hero>div>p{max-width:48ch;margin:2rem 0;color:#bcc6ca;font-size:clamp(1.05rem,1.5vw,1.27rem);line-height:1.65}.planner-hero ul{display:flex;flex-wrap:wrap;margin:2rem 0 0;padding:0;list-style:none}.planner-hero li{padding:.4rem .8rem;border-left:1px solid var(--fine-rule);color:var(--muted);font:.62rem/1 var(--font-mono);text-transform:uppercase}.planner-hero li:first-child{padding-left:0;border:0}.planner-hero figure{position:relative;min-height:31rem;margin:0;padding:5rem 2rem 2rem;border:1px solid var(--rule);background:linear-gradient(145deg,rgba(39,199,244,.07),transparent 45%),var(--surface)}figure figcaption{position:absolute;top:0;right:0;left:0;display:flex;justify-content:space-between;padding:1rem;border-bottom:1px solid var(--fine-rule);color:var(--muted);font:.6rem/1.4 var(--font-mono);text-transform:uppercase}figure small{color:var(--signal)}.origin{display:grid;width:8rem;height:8rem;place-items:center;margin:6rem 0;border:1px solid var(--source);border-radius:50%;font:.65rem/1.4 var(--font-mono);text-align:center}.planner-hero figure ol{position:absolute;top:6rem;right:2rem;bottom:3rem;display:grid;align-content:space-around;width:52%;margin:0;padding:0;list-style:none}.planner-hero figure li{position:relative;padding:.8rem;border-left:1px solid var(--source);background:rgba(255,255,255,.025);color:var(--ink);font:.7rem/1.3 var(--font-mono)}.planner-hero figure li:before{position:absolute;right:100%;top:50%;width:5rem;height:1px;background:var(--fine-rule);content:""}.planner-stage{padding:clamp(4rem,8vw,8rem) var(--gutter)}.planner-stage>header{display:grid;grid-template-columns:.3fr .8fr .9fr;gap:2rem;margin-bottom:3rem}.planner-stage>header span{color:var(--source);font:.65rem/1.4 var(--font-mono)}.planner-stage>header h2{margin:0;font:720 clamp(2.5rem,5vw,5rem)/.96 var(--font-display);letter-spacing:-.055em}.planner-stage>header p{max-width:45ch;margin:0;color:var(--muted);line-height:1.65}.planner-stage :global([data-planner-form]){display:grid;padding:clamp(1.5rem,3vw,2.5rem);border:1px solid var(--rule);background:var(--surface)}.planner-stage :global([data-planner-form]>label){margin-bottom:1rem;color:var(--muted);font:.65rem/1 var(--font-mono);text-transform:uppercase}.planner-stage :global(input){padding:.7rem 0;border:0;border-bottom:1px solid var(--source);outline:0;background:transparent;color:var(--ink);font:650 clamp(1.6rem,3.2vw,3.2rem)/1.15 var(--font-display)}.planner-stage :global(output){justify-self:end;margin:.7rem 0;color:var(--muted);font:.63rem/1 var(--font-mono)}.planner-stage :global(.tool-options){display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem}.planner-stage :global(.tool-options label){display:grid;gap:.6rem;color:var(--muted);font:.65rem/1 var(--font-mono);text-transform:uppercase}.planner-stage :global(select){padding:.8rem;border:1px solid var(--rule);background:#0c1114;color:var(--ink)}.planner-stage :global(button){justify-self:start;margin-top:1.2rem;padding:1rem 1.3rem;border:1px solid var(--source);background:var(--source);color:#041014;font-weight:750}.planner-stage :global(button:disabled){border-color:var(--rule);background:#1a2125;color:#778287}.planner-stage :global([data-planner-form] p){max-width:70ch;color:var(--signal);font-size:.78rem;line-height:1.5}.planner-stage :global([data-plan-output]){margin-top:4rem;border-top:1px solid var(--source)}.planner-stage :global([data-plan-output] h2){font:700 clamp(2.2rem,4vw,4rem)/1 var(--font-display)}.planner-stage :global([data-result-queries]),.planner-stage :global([data-result-sources]){margin:0;padding:0;list-style:none}.planner-stage :global([data-result-queries] li){display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:1.25rem 0;border-bottom:1px solid var(--fine-rule)}.planner-stage :global([data-result-queries] span){color:var(--source);font-family:var(--font-mono)}.planner-stage :global(.source-results){margin-top:3rem}.planner-stage :global([data-result-sources] li){padding:.7rem 0;border-bottom:1px solid var(--fine-rule)}.contract{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--rule)}.contract div{padding:2rem var(--gutter)}.contract div+div{border-left:1px solid var(--fine-rule)}.contract span{color:var(--source);font:.62rem/1 var(--font-mono);text-transform:uppercase}.contract strong{display:block;margin:1.2rem 0 .5rem}.contract p{margin:0;color:var(--muted);font-size:.75rem}.secondary{display:grid;grid-template-columns:1fr minmax(25rem,.8fr);gap:5rem;align-items:center}.secondary p{max-width:55ch;color:var(--muted);line-height:1.65}.steps{display:grid;grid-template-columns:auto 1fr auto 1fr auto;align-items:center}.steps span{display:grid;width:6rem;height:6rem;place-items:center;border:1px solid var(--rule);font:.6rem/1 var(--font-mono)}.steps i{height:1px;background:var(--source)}.method{display:grid;grid-template-columns:.35fr 1fr auto;gap:3rem;align-items:end}.method>p{color:var(--source);font:.65rem/1.4 var(--font-mono);text-transform:uppercase}.method h2{margin:0;font:700 clamp(2.5rem,5vw,5rem)/.96 var(--font-display);letter-spacing:-.055em}.method a{display:inline-flex;gap:.7rem;padding:.9rem;border:1px solid var(--rule);font-size:.78rem;text-decoration:none}
@media(max-width:1050px){.planner-hero,.secondary,.method,.planner-stage>header{grid-template-columns:1fr}.planner-hero>*{min-width:0}.planner-hero{min-height:0}.contract{grid-template-columns:1fr 1fr}.contract div:nth-child(3){border-left:0;border-top:1px solid var(--fine-rule)}.contract div:nth-child(4){border-top:1px solid var(--fine-rule)}}@media(max-width:600px){.planner-hero{grid-template-columns:1fr;padding-block:4rem}.planner-hero h1{font-size:clamp(3rem,14vw,5.2rem);overflow-wrap:break-word}.planner-hero figure{min-height:25rem}.origin{width:6rem;height:6rem}.planner-hero figure ol{right:1rem;width:56%}.contract{grid-template-columns:1fr}.contract div+div,.contract div:nth-child(3){border-top:1px solid var(--fine-rule);border-left:0}.steps span{width:4.7rem;height:4.7rem}.planner-stage :global(.tool-options){grid-template-columns:1fr}}
.planner-stage :global([data-planner-form]){min-width:0}.planner-stage :global([data-planner-form]>*),.planner-stage :global(.tool-options>*){min-width:0;max-width:100%}.planner-stage :global(input),.planner-stage :global(select){width:100%}
</style>
