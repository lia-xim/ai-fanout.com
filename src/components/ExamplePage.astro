---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { ExamplePage as ExamplePageData } from "../data/examples";
import { exampleObservations } from "../data/examples";
interface Props{page:ExamplePageData;lang:"en"|"de"}
const{page,lang}=Astro.props,de=lang==="de",base=de?"/de/beispiele":"/examples",canonicalPath=`${base}/${page.slug}`,alternatePath=de?`/examples/${page.pairedSlug}`:`/de/beispiele/${page.pairedSlug}`;
const runs=page.observationIds.map(id=>exampleObservations.find(run=>run.id===id)).filter(Boolean);
const statusLabel=(status:string)=>status==="completed"?(de?"Lauf abgeschlossen":"Run completed"):(de?"Suchaktion erfasst; finale Antwort am Tokenlimit":"Search action captured; final answer hit token limit");
const schema={"@context":"https://schema.org","@type":"TechArticle",headline:page.title,description:page.description,datePublished:"2026-08-27",dateModified:"2026-08-28",inLanguage:lang,author:{"@type":"Person",name:"Matthias Ramahi"},mainEntityOfPage:`https://ai-fanout.com${canonicalPath}`};
---
<BaseLayout lang={lang} title={page.title} canonicalPath={canonicalPath} alternatePath={alternatePath} description={page.description} structuredData={schema}>
  <article class="example-page">
    <header><nav aria-label={de?"Brotkrumen":"Breadcrumb"}><a href={base}>{de?"Beispiele":"Examples"}</a><span>/</span><span aria-current="page">27.08.2026</span></nav><p>{de?"DATIERTES BEISPIEL":"DATED EXAMPLE"}</p><h1>{page.title}</h1><div class="lead"><strong>{page.question}</strong><p>{page.answer}</p></div></header>
    <section class="protocol"><div><span>01</span><h2>{de?"Festes Protokoll":"Fixed protocol"}</h2></div><dl><div><dt>{de?"Anbieter":"Provider"}</dt><dd>OpenAI API</dd></div><div><dt>{de?"Modell":"Model"}</dt><dd>GPT-5.6 Luna</dd></div><div><dt>Tool</dt><dd>web_search · low context</dd></div><div><dt>Limits</dt><dd>8 searches · 500 output tokens</dd></div><div><dt>{de?"Speicherung":"Provider storage"}</dt><dd>store: false</dd></div><div><dt>{de?"Version":"Version"}</dt><dd>native-fanout-tool/1.0.0</dd></div></dl><div class="downloads"><a href="/examples/openai-observations-2026-08-27.json">JSON</a><a href="/examples/openai-observations-2026-08-27.csv">CSV</a><a href="/contracts/example-observation.schema.v1.json">Schema v1</a></div></section>
    <section class="runs"><div><span>02</span><h2>{de?"Beobachtete Queries":"Observed queries"}</h2><p>{de?"Originale Query-Strings aus der API-Antwort. Keine nachträglich erzeugten Suchideen.":"Original query strings from the API response. These are not post-run search ideas."}</p></div><div class="run-grid">{runs.map(run=><article><header><span>{new Date(run!.observedAt).toLocaleString(de?"de-DE":"en-GB",{dateStyle:"medium",timeStyle:"medium",timeZone:"Europe/Berlin"})}</span><strong>{run!.input.keyword}</strong><small>{run!.input.country} · {run!.input.language} · {statusLabel(run!.providerResponseStatus)}</small></header><ol>{run!.queries.map(query=><li>{query}</li>)}</ol><div class="domains"><p>{de?"Quellendomains der Suchaktion – keine Query-Zuordnung":"Source domains on the search action — not mapped to individual queries"}</p><ul>{run!.sourceDomains.map(domain=><li>{domain}</li>)}</ul></div><dl><div><dt>Input</dt><dd>{run!.usage.inputTokens.toLocaleString()} Tokens</dd></div><div><dt>Output</dt><dd>{run!.usage.outputTokens.toLocaleString()} Tokens</dd></div><div><dt>{de?"Schätzung":"Estimate"}</dt><dd>${run!.usage.estimatedCostUsd.toFixed(4)}</dd></div></dl></article>)}</div></section>
    <section class="reading"><div><span>03</span><h2>{de?"Einordnung des Betreibers":"Operator reading"}</h2><p>{de?"Dieser Abschnitt interpretiert die Beobachtung. Er ist kein Feld aus der Provider-Antwort.":"This section interprets the observation. It is not a field returned by the provider."}</p></div><ul>{page.findings.map(item=><li>{item}</li>)}</ul></section>
    <section class="limits"><div><span>04</span><h2>{de?"Was es nicht beweist":"What it does not prove"}</h2></div><ul>{page.limits.map(item=><li>{item}</li>)}</ul><p>{de?"Dieses Beispiel ist kein unabhängiger Modellbenchmark. Es zeigt einzelne API-Beobachtungen unter einem dokumentierten Protokoll und bildet keine ChatGPT- oder Gemini-Oberfläche ab.":"This example is not an independent model benchmark. It documents individual API observations under a published protocol and does not reproduce the ChatGPT or Gemini consumer interface."}<br/><a href="/examples/monthly-observation-plan.v1.json">{de?"Geplanten monatlichen Themenkatalog ansehen":"View the planned monthly topic set"}</a></p></section>
  </article>
</BaseLayout>
<style>
  .example-page>header,.example-page>section{padding:clamp(2.5rem,6vw,6rem) var(--gutter);border-bottom:1px solid var(--rule)}.example-page>header nav{display:flex;gap:.6rem;color:var(--muted);font:.68rem/1 var(--font-mono)}.example-page>header>p,.example-page section>div>span{margin:3rem 0 1rem;color:var(--source);font:.65rem/1 var(--font-mono);letter-spacing:.08em}.example-page h1{max-width:12ch;margin:0;font:790 clamp(3.4rem,8vw,8rem)/.88 var(--font-display);letter-spacing:-.07em}.lead{display:grid;grid-template-columns:.75fr 1.25fr;gap:clamp(2rem,8vw,8rem);margin-top:4rem;padding-top:1.5rem;border-top:1px solid var(--rule)}.lead strong{font-size:1.2rem;line-height:1.5}.lead p{margin:0;color:#c5cdd0;font-size:1.05rem;line-height:1.7}.protocol,.reading,.limits{display:grid;grid-template-columns:minmax(14rem,.65fr) minmax(0,1.35fr);gap:clamp(2rem,7vw,8rem)}.protocol>div>span,.reading>div>span,.limits>div>span{display:block;margin:0 0 1rem}.protocol h2,.reading h2,.limits h2,.runs h2{margin:0;font-size:clamp(1.8rem,4vw,3.5rem)}.protocol dl{display:grid;grid-template-columns:repeat(2,1fr);margin:0;border-top:1px solid var(--rule)}.protocol dl div{padding:1rem 0;border-bottom:1px solid var(--fine-rule)}.protocol dt,.runs dt{color:var(--muted);font:.65rem/1 var(--font-mono)}.protocol dd,.runs dd{margin:.45rem 0 0}.protocol>a{grid-column:2;color:var(--source)}.runs>div:first-child{display:grid;grid-template-columns:.5fr 1fr;gap:2rem}.runs>div:first-child>span{margin:0}.runs>div:first-child p{margin:0;color:var(--muted);line-height:1.6}.run-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:3rem}.run-grid>article{padding:1.25rem;border:1px solid var(--rule)}.run-grid article header{display:grid;gap:.45rem}.run-grid article header>span,.run-grid article header>small{color:var(--muted);font:.62rem/1.3 var(--font-mono)}.run-grid ol{margin:1.25rem 0;padding-left:1.35rem}.run-grid ol li{margin:.65rem 0;line-height:1.45}.domains{padding-top:1rem;border-top:1px solid var(--fine-rule)}.domains p{color:var(--source);font:.62rem/1 var(--font-mono);text-transform:uppercase}.domains ul{display:flex;flex-wrap:wrap;gap:.35rem;margin:0;padding:0;list-style:none}.domains li{padding:.35rem .45rem;background:var(--source-soft);font:.6rem/1 var(--font-mono)}.run-grid dl{display:flex;gap:1rem;margin:1.25rem 0 0}.run-grid dl div{flex:1}.reading>ul,.limits>ul{margin:0;padding:0;list-style:none}.reading>ul li,.limits>ul li{padding:1.2rem 0;border-bottom:1px solid var(--fine-rule);font-size:1rem;line-height:1.55}.reading>ul li::before{content:"✓";margin-right:.8rem;color:var(--source)}.limits{background:color-mix(in srgb,var(--surface) 92%,#201008)}.limits>ul li::before{content:"×";margin-right:.8rem;color:var(--signal)}.limits>p{grid-column:2;margin:1.5rem 0 0;color:var(--muted);line-height:1.6}
  @media(max-width:760px){.lead,.protocol,.reading,.limits,.runs>div:first-child,.run-grid{grid-template-columns:1fr}.protocol>a,.limits>p{grid-column:1}.example-page h1{font-size:clamp(3.2rem,17vw,5.5rem)}.run-grid dl{display:grid;grid-template-columns:repeat(3,1fr)}}
  .example-page h1{max-width:16ch;font-size:clamp(3rem,5vw,5.25rem);line-height:.98;letter-spacing:-.05em}.protocol h2,.reading h2,.limits h2,.runs h2{font-size:clamp(1.8rem,2.8vw,2.75rem);line-height:1.08}.runs>div:first-child p,.reading>ul li,.limits>ul li,.limits>p{font-size:1.06rem;line-height:1.68}
  @media(max-width:760px){.example-page h1{font-size:clamp(2.7rem,12vw,4rem);line-height:1}.protocol h2,.reading h2,.limits h2,.runs h2{font-size:clamp(1.75rem,8vw,2.45rem)}}
  .downloads{grid-column:2;display:flex;flex-wrap:wrap;gap:1rem}.downloads a,.limits a{color:var(--source)}.reading>div>p{color:var(--muted);line-height:1.6}
  @media(max-width:760px){.downloads{grid-column:1}}
</style>
