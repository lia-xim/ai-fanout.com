---
import BaseLayout from "../../layouts/BaseLayout.astro";import {governance,methodologySections,observationSchema} from "../../data/research";
---
<BaseLayout title="Evidence observation methodology" canonicalPath="/research/methodology" description="The preregistration scaffold and local calculation contract for observable public AI-answer evidence."><div class="document-layout"><aside class="document-aside"><dl><div><dt>State</dt><dd>Public draft</dd></div><div><dt>Owner</dt><dd>{governance.researchOwner}</dd></div><div><dt>Protocol</dt><dd>0.1</dd></div><div><dt>Public batches</dt><dd>0</dd></div></dl></aside><article class="document-body"><h1>Evidence observation methodology</h1><p class="document-intro">A separate method for the browser-local Evidence Lab. No provider collection has started and no provider benchmark dataset exists.</p><ol class="method-list">{methodologySections.map(section=><li id={section.id}><span>{section.number}</span><div><h2>{section.title}</h2><p>{section.body}</p></div></li>)}</ol><h2>Observation schema</h2><pre><code>{`{\n${observationSchema.map(([field])=>`  ${field}:`).join("\n")}\n}`}</code></pre><p><a href="/methodology">Return to the AI Fanout Planner methodology</a>.</p></article></div></BaseLayout>
<style>.method-list{margin:0;padding:0;border-top:1px solid var(--rule);list-style:none}.method-list li{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:1.2rem 0;border-bottom:1px solid var(--fine-rule)}.method-list li>span{color:var(--signal)}.method-list h2{margin:0}.method-list p{color:var(--muted);line-height:1.6}pre{overflow:auto;padding:1.5rem;border:1px solid var(--rule);color:var(--source)}</style>
