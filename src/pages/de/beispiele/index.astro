---
import BaseLayout from "../../../layouts/BaseLayout.astro";import ArrowIcon from "../../../components/ArrowIcon.astro";import { germanExamples } from "../../../data/examples";
---
<BaseLayout lang="de" title="Beispiele für AI Query Fanout" canonicalPath="/de/beispiele" alternatePath="/examples" description="Datierte, reproduzierbare OpenAI-Fanout-Beobachtungen zu Modellvergleich, Land, Wiederholung und Quellen bei Vergleichsfragen."><header class="page-head"><h1>Beispiele, die du prüfen kannst.</h1><div class="page-head-copy"><p>Echte, datierte API-Beobachtungen. Eingabe, Protokoll, Query-Strings, Quellendomains, Tokenverbrauch und Grenzen stehen zusammen.</p><p class="meta-line">Erhoben am 27. August 2026 · Owner-Läufe · kein unabhängiger Benchmark</p></div></header><section class="example-index section-pad">{germanExamples.map((page,index)=><a href={`/de/beispiele/${page.slug}`}><span>{String(index+1).padStart(2,"0")}</span><div><strong>{page.title}</strong><p>{page.question}</p></div><ArrowIcon/></a>)}</section></BaseLayout><style>.example-index{display:grid}.example-index a{display:grid;grid-template-columns:4rem 1fr auto;gap:1rem;align-items:center;padding:1.5rem 0;border-bottom:1px solid var(--rule);text-decoration:none}.example-index span{color:var(--source);font: .7rem/1 var(--font-mono)}.example-index strong{font-size:1.15rem}.example-index p{margin:.4rem 0 0;color:var(--muted)}@media(max-width:600px){.example-index a{grid-template-columns:2.5rem 1fr}.example-index svg{display:none}}</style>
