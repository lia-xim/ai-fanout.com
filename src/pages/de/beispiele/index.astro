---
import BaseLayout from "../../../layouts/BaseLayout.astro";import ArrowIcon from "../../../components/ArrowIcon.astro";import { germanExamples } from "../../../data/examples";
---
<BaseLayout lang="de" title="Beispiele für AI Query Fanout" canonicalPath="/de/beispiele" alternatePath="/examples" description="Datierte, reproduzierbare OpenAI-Fanout-Beobachtungen zu Modellvergleich, Land, Wiederholung und Quellen bei Vergleichsfragen."><header class="page-head"><h1>Beispiele, die du prüfen kannst.</h1><div class="page-head-copy"><p>Echte, datierte API-Beobachtungen. Eingabe, Protokoll, Query-Strings, Quellendomains, Tokenverbrauch und Grenzen stehen zusammen.</p><p class="meta-line">Erhoben am 27. August 2026 · Owner-Läufe · kein unabhängiger Benchmark</p></div></header><section class="example-index section-pad">{germanExamples.map((page,index)=><a href={`/de/beispiele/${page.slug}`}><span>{String(index+1).padStart(2,"0")}</span><div><strong>{page.title}</strong><p>{page.question}</p></div><ArrowIcon/></a>)}</section><section class="research-plan section-pad"><div><p>WIEDERHOLBARE BELEGE</p><h2>Ein fester Katalog mit 12 Themen für monatliche Läufe.</h2></div><div><p>Der Themenkatalog deckt Informations-, Vergleichs-, Kauf-, Fehler-, Umsetzungs- und lokale Fragen ab. Eingabe, Locale und Berichtsfelder stehen vor den nächsten Läufen fest. Das ist ein Forschungsplan und keine Seite mit behaupteten Ergebnissen.</p><nav><a href="/examples/monthly-observation-plan.v1.json">Beobachtungsplan öffnen</a><a href="/examples/openai-observations-2026-08-27.csv">Aktuelle CSV laden</a><a href="/contracts/example-observation.schema.v1.json">Schema v1 ansehen</a></nav></div></section></BaseLayout><style>.example-index{display:grid}.example-index a{display:grid;grid-template-columns:4rem 1fr auto;gap:1rem;align-items:center;padding:1.5rem 0;border-bottom:1px solid var(--rule);text-decoration:none}.example-index span{color:var(--source);font: .7rem/1 var(--font-mono)}.example-index strong{font-size:1.15rem}.example-index p{margin:.4rem 0 0;color:var(--muted)}.research-plan{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,8vw,8rem);border-top:1px solid var(--rule)}.research-plan>div:first-child>p{color:var(--source);font:.65rem/1 var(--font-mono)}.research-plan h2{max-width:18ch;margin:1rem 0 0;font-size:clamp(2rem,4vw,3.5rem)}.research-plan>div:last-child>p{margin:0;color:var(--muted);font-size:1.05rem;line-height:1.7}.research-plan nav{display:flex;flex-wrap:wrap;gap:1.25rem;margin-top:2rem}.research-plan a{color:var(--source)}@media(max-width:600px){.example-index a{grid-template-columns:2.5rem 1fr}.example-index svg{display:none}.research-plan{grid-template-columns:1fr}}</style>
