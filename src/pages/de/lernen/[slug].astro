---
import ArrowIcon from "../../../components/ArrowIcon.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { germanArticles } from "../../../data/observed-query-articles";
import type { LibraryArticle } from "../../../data/library";
import "../../../styles/library-article.css";
import evidenceManifest from "../../../../manifests/rights-and-sources.v1.json";
export function getStaticPaths(){return germanArticles.map(article=>({params:{slug:article.slug},props:{article}}))}
interface Props{article:LibraryArticle}const{article}=Astro.props;const sources=evidenceManifest.sources.filter(source=>article.sourceIds.includes(source.id));const related=article.relatedSlugs.map(slug=>germanArticles.find(item=>item.slug===slug)).filter((item):item is LibraryArticle=>Boolean(item));const canonicalPath=`/de/lernen/${article.slug}`;const schema={"@context":"https://schema.org","@type":"TechArticle",headline:article.title,description:article.description,dateModified:article.reviewedAt,inLanguage:"de",author:{"@type":"Person",name:"Matthias Ramahi",url:"https://ai-fanout.com/transparency"},publisher:{"@type":"Organization",name:"ai-fanout.com",url:"https://ai-fanout.com"},mainEntityOfPage:`https://ai-fanout.com${canonicalPath}`};
---
<BaseLayout lang="de" title={article.title} canonicalPath={canonicalPath} alternatePath={article.pairedSlug?`/library/${article.pairedSlug}`:undefined} description={article.description} pageClass="library-article-page" structuredData={schema}><article><header class="article-hero"><nav class="breadcrumb" aria-label="Brotkrumen"><a href="/de/lernen">Lernen</a><span>/</span><span aria-current="page">{article.shortTitle}</span></nav><div class="article-hero-grid"><div><p class="article-code">{article.number} · Erklärung</p><h1>{article.title}</h1></div><dl><div><dt>Diese Seite hilft dir</dt><dd>{article.primaryIntent}</dd></div><div><dt>Quellen</dt><dd>Unten erklärt</dd></div><div><dt>Geprüft von</dt><dd>Matthias Ramahi · keine unabhängige Prüfung behauptet</dd></div><div><dt>Aktualisiert</dt><dd>{article.reviewedAt}</dd></div></dl></div></header><section class="direct-answer"><div><span>Kurzantwort</span><i></i></div><div><h2>{article.shortTitle}</h2><p>{article.answer}</p><small>{article.useWhen}</small></div></section><div class="article-grid"><aside class="article-rail"><p>Auf dieser Seite</p><ol>{article.sections.map((section,index)=><li><a href={`#${section.id}`}><span>{String(index+1).padStart(2,"0")}</span>{section.title}</a></li>)}</ol><a class="rail-back" href="/de/lernen"><ArrowIcon direction="left"/> Alle Erklärungen</a></aside><div class="article-content">{article.sections.map((section,index)=><section id={section.id} class="article-section"><div class="section-label"><span>{String(index+1).padStart(2,"0")}</span></div><div><h2>{section.title}</h2>{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></section>)}<section class="source-notes"><div><span class="section-number">Q</span><h2>Verwendete Quellen</h2></div><p>Diese Quellen stützen die beschriebenen Funktionen und Grenzen. Sie belegen keine darüber hinausgehenden Aussagen.</p><ol>{sources.map(source=><li><span>{source.id}</span><div><strong>{source.title}</strong><p>{source.supports}</p></div>{source.location.startsWith("https://")?<a href={source.location} rel="external">Öffnen <ArrowIcon size={15}/></a>:<small>Eigentümer-Nachweis</small>}</li>)}</ol></section></div></div><section class="related-references"><div><span class="section-number">Weiter</span><h2>Passende Erklärungen</h2></div><ol>{related.map(item=><li><a href={`/de/lernen/${item.slug}`}><span>{item.number}</span><strong>{item.shortTitle}</strong><small>Erklärung</small><ArrowIcon/></a></li>)}</ol></section></article></BaseLayout>
