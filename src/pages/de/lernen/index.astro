---
import ArrowIcon from "../../../components/ArrowIcon.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { germanArticles, groupsFor } from "../../../data/observed-query-articles";
const groups = groupsFor(germanArticles);
const labels = { Concept:"Grundlagen", Measurement:"Ergebnisse prüfen", Method:"Funktionsweise", "Data standard":"Daten", "Field guide":"SEO-Praxis" } as const;
---
<BaseLayout lang="de" title="AI Query Fanout verstehen" canonicalPath="/de/lernen" alternatePath="/library" description="Klare Erklärungen zu AI Query Fanout, OpenAI-Websuche, Zitaten, schwankenden Ergebnissen und SEO-Nutzung.">
  <header class="page-head"><h1>Was nach dem Keyword passiert.</h1><div class="page-head-copy"><p>{germanArticles.length} klare Erklärungen zu Query Fanout, OpenAI, Gemini, Quellen, Schwankungen und sinnvoller SEO-Nutzung.</p><p class="meta-line">Wissensbereich · geprüft am 27. August 2026</p></div></header>
  <section class="section-pad section-rule"><div class="library-filters" aria-label="Themen filtern"><button type="button" data-filter="all" aria-pressed="true">Alle <span>{germanArticles.length}</span></button>{groups.map(group => <button type="button" data-filter={group.category} aria-pressed="false">{labels[group.category]} <span>{group.articles.length}</span></button>)}</div><ol class="library-list" aria-live="polite">{germanArticles.map(article => <li data-library-item data-category={article.category}><a href={`/de/lernen/${article.slug}`}><span class="entry-number">{article.number}</span><span class="entry-type">{labels[article.category]}</span><span class="entry-main"><strong>{article.shortTitle}</strong><small>{article.primaryIntent}</small></span><ArrowIcon/></a></li>)}</ol></section>
  <script>const buttons=[...document.querySelectorAll<HTMLButtonElement>("[data-filter]")],items=[...document.querySelectorAll<HTMLElement>("[data-library-item]")];for(const button of buttons)button.addEventListener("click",()=>{const filter=button.dataset.filter??"all";buttons.forEach(item=>item.setAttribute("aria-pressed",String(item===button)));items.forEach(item=>item.hidden=filter!=="all"&&item.dataset.category!==filter)})</script>
</BaseLayout>
<style>.library-filters{display:flex;flex-wrap:wrap;border-block:1px solid var(--rule)}.library-filters button{min-height:3.3rem;padding:.8rem 1rem;border:0;border-right:1px solid var(--fine-rule);background:transparent;color:var(--muted);font:.72rem/1.3 var(--font-mono);cursor:pointer}.library-filters button[aria-pressed="true"]{background:var(--source);color:#041014}.library-list{margin:2rem 0 0;padding:0;list-style:none}.library-list li{border-bottom:1px solid var(--fine-rule)}.library-list li[hidden]{display:none}.library-list a{display:grid;grid-template-columns:4rem 9rem minmax(0,1fr) 1.5rem;gap:1.2rem;align-items:center;min-height:6.2rem;padding:1rem;text-decoration:none}.entry-number,.entry-type{color:var(--muted);font:.7rem/1.4 var(--font-mono);text-transform:uppercase}.entry-type{color:var(--source)}.entry-main{display:grid;grid-template-columns:minmax(12rem,.55fr) minmax(0,1fr);gap:2rem}.entry-main small{color:var(--muted);line-height:1.5}@media(max-width:700px){.library-list a{grid-template-columns:3rem 1fr 1rem}.entry-type{grid-column:2}.entry-main{grid-column:2;grid-template-columns:1fr;gap:.4rem}.library-list svg{grid-column:3;grid-row:1/span 2}}
</style>
