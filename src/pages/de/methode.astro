import BaseLayout from "../../layouts/BaseLayout.astro";
const steps=[["Eingabe","Ein Thema oder eine kurze Frage mit 2–60 Zeichen und höchstens 160 UTF-8-Bytes. URLs, Dateien, Zeilenumbrüche und zusätzliche Felder werden abgelehnt."],["Mensch-Prüfung","Cloudflare Turnstile muss bestanden sein, bevor Kontingent oder Budget reserviert wird."],["Nativer Anbieter","Wähle OpenAI GPT-5.6 Luna oder Gemini 3.7 Flash. Der Server ruft den Anbieter direkt auf; kein Provider-Key gelangt in den Browser."],["Echte Websuche","OpenAI erhält das eingebaute web_search-Tool, Gemini google_search. Die feste öffentliche Anweisung fordert eine natürliche Suche und eine kurze Antwort."],["Nur beobachtete Ausgabe","Der Parser gibt nur Query-Strings und zitierte URLs zurück, die im Provider-Response stehen. Fehlt eine Query, wird keine Ersatzliste erfunden."],["Keine Rohdaten-Speicherung","Thema und Provider-Response bleiben flüchtig. Gespeichert werden nur gesalzene Nutzungs-Hashes, Versionen, Status, konservative Kostenreserve, Tokenzahlen und Laufzeit."],["Harte Limits","Fünf Versuche je gehashtem IP-Bucket in 24 Stunden und 40 pro UTC-Tag. Native Läufe reservieren 0,50 Euro innerhalb des gemeinsamen Monatslimits von 25 Euro soft und 30 Euro hart."],["Getrennter Ideenmodus","Suchideen erzeugt über OpenRouter zehn modellierte Richtungen ohne Websuche. Dieser Modus heißt weder Native noch Controlled Fanout."]];
---
<BaseLayout lang="de" title="So funktioniert das AI Query Fanout Tool" canonicalPath="/de/methode" alternatePath="/methodology" description="Das genaue native OpenAI- und Gemini-Suchprotokoll mit Nachweisgrenze, Datenschutz und harten Limits."><header class="page-head"><h1>So funktioniert das kostenlose Tool</h1><div class="page-head-copy"><p>Ein Thema rein. Die API führt Websuchen aus. Wir zeigen nur Queries und Quellen, die der Response offenlegt.</p><p class="meta-line">Native Tool 1.0 · OpenAI Responses + Gemini Interactions · Betreiber Matthias Ramahi</p></div></header><div class="document-layout"><aside class="document-aside"><dl><div><dt>Hauptmodus</dt><dd>Native Fanout</dd></div><div><dt>Anbieter</dt><dd>OpenAI + Gemini</dd></div><div><dt>Ausgabe</dt><dd>0–8 Query-Strings</dd></div><div><dt>Zeitlimit</dt><dd>20 Sekunden</dd></div></dl></aside><article class="document-body"><h2>Ein echter API-Suchlauf, kein Browser-Mitschnitt.</h2><p class="document-intro">Native Fanout beobachtet Suchaktionen, die eine direkte Provider-API unter einem festen, veröffentlichten Protokoll offenlegt. Das Tool liest weder chatgpt.com noch gemini.google.com, Browser-Netzwerkdaten, Systemprompts, private Retrieval-Spuren oder Gedankengänge aus.</p><ol class="controls">{steps.map(([title,copy],index)=><li><span>{String(index+1).padStart(2,"0")}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol><section><h2>Was „native“ wirklich belegt</h2><p>Belegt ist, dass dieser API-Lauf zu diesem Zeitpunkt diese Query-Strings und Quellen offengelegt hat. Nicht belegt ist, dass eine Chat-Oberfläche denselben Fanout erzeugt, die Quelle richtig liegt oder die Query messbare Nachfrage hat.</p></section><section><h2>So nutzt du das für SEO</h2><p>Gruppiere Queries nach Nutzeraufgabe. Ergänze eine bestehende Seite, wenn sie die Aufgabe sinnvoll beantworten kann. Eine neue URL braucht eine eigene Zielgruppe, Intention, Belege und einen klaren nächsten Schritt.</p></section><section><h2>Verantwortung</h2><p>Matthias Ramahi verantwortet Protokollversionen, Korrekturen, Reviewerstatus und Kostenrahmen. Das Tool ist kein unabhängiger Anbieter-Benchmark.</p></section></article></div></BaseLayout>
