---
import ArrowIcon from "../components/ArrowIcon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { launchGates } from "../data/research";
---

<BaseLayout title="Project status" canonicalPath="/tracker" robots="noindex, follow" description="Internal status of planned checks and public claims on ai-fanout.com.">
  <header class="page-head">
    <h1>Project status</h1>
    <div class="page-head-copy">
      <p>The website is live. We have not run or published an independent comparison of AI providers.</p>
      <p class="meta-line status-open">Website · live · provider comparison not started</p>
    </div>
  </header>

  <section class="tracker-overview section-pad section-rule" aria-labelledby="overview-title">
    <div><span class="section-number">01</span><h2 id="overview-title" class="section-title">Readiness, not progress theatre</h2></div>
    <div class="batch-track" aria-label="Comparable batches: zero of three required">
      <p><strong>0</strong><span>of 3 comparable batches</span></p>
      <ol><li><span></span><strong>Batch 01</strong><small>Not run</small></li><li><span></span><strong>Batch 02</strong><small>Not run</small></li><li><span></span><strong>Batch 03</strong><small>Not run</small></li></ol>
    </div>
  </section>

  <section class="section-pad section-rule" aria-labelledby="gate-list-title">
    <span class="section-number">02</span>
    <h2 id="gate-list-title" class="section-title">Evidence gates</h2>
    <ol class="gate-register ruled-list">
      {launchGates.map((gate) => (
        <li>
          <span>{gate.id}</span><div><h3>{gate.label}</h3><p>{gate.explanation}</p></div><strong>{gate.state.replace("_", " ")}</strong>
        </li>
      ))}
    </ol>
  </section>

  <section class="comparability section-pad section-rule" aria-labelledby="comparability-title">
    <div><span class="section-number">03</span><h2 id="comparability-title" class="section-title">Comparability log</h2></div>
    <div class="empty-log"><strong>No series exists.</strong><p>Model, route, prompt, surface, interface, locale or policy changes will be recorded here only after a protocol is frozen and collection starts.</p></div>
  </section>

  <section class="section-pad tracker-next"><p>Next review: 22 November 2026. Research Owner: Matthias Ramahi.</p><a class="text-action" href="/transparency">Inspect sources and open evidence gaps <ArrowIcon /></a></section>
</BaseLayout>

<style>
  .tracker-overview, .comparability { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: clamp(2rem, 7vw, 8rem); }
  .batch-track { align-self: end; }
  .batch-track > p { display: flex; gap: 1rem; align-items: baseline; margin: 0 0 2rem; }
  .batch-track > p strong { color: var(--signal); font: 400 clamp(4rem, 8vw, 8rem)/0.8 var(--font-display); }
  .batch-track > p span { font: 0.78rem/1.4 var(--font-mono); text-transform: uppercase; }
  .batch-track ol { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; padding: 0; border-top: 1px solid var(--rule); list-style: none; }
  .batch-track li { position: relative; padding: 1.5rem 1rem 0 0; }
  .batch-track li::before { position: absolute; top: -0.38rem; left: 0; width: 0.7rem; height: 0.7rem; border: 1px solid var(--ink); border-radius: 50%; background: var(--paper); content: ""; }
  .batch-track strong, .batch-track small { display: block; font: 0.74rem/1.4 var(--font-mono); }
  .batch-track small { margin-top: 0.35rem; color: var(--muted); }
  .gate-register { margin-top: 3rem; }
  .gate-register li { display: grid; grid-template-columns: 5rem minmax(0, 1fr) auto; gap: 1rem; padding-block: 1.4rem; }
  .gate-register > li > span, .gate-register > li > strong { font: 0.74rem/1.4 var(--font-mono); text-transform: uppercase; }
  .gate-register > li > span, .gate-register > li > strong { color: var(--signal); }
  .gate-register h3 { margin: 0; font-size: 1rem; }
  .gate-register p { max-width: 64ch; margin: 0.55rem 0 0; color: var(--muted); line-height: 1.55; }
  .empty-log { padding-block: 1.5rem; border-block: 1px solid var(--rule); }
  .empty-log strong { font: 400 clamp(2.2rem, 5vw, 4.5rem)/1 var(--font-display); }
  .empty-log p { max-width: 52ch; margin: 1.5rem 0 0; line-height: 1.6; }
  .tracker-next { display: flex; justify-content: space-between; gap: 2rem; align-items: center; }
  .tracker-next p { margin: 0; font: 0.78rem/1.5 var(--font-mono); }
  @media (max-width: 760px) { .tracker-overview, .comparability { grid-template-columns: 1fr; } .gate-register li { grid-template-columns: 4rem minmax(0, 1fr); } .gate-register > li > strong { grid-column: 2; } .tracker-next { align-items: flex-start; flex-direction: column; } }
</style>
