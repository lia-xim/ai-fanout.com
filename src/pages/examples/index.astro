---
import BaseLayout from "../../layouts/BaseLayout.astro";import ArrowIcon from "../../components/ArrowIcon.astro";import { englishExamples } from "../../data/examples";
---
<BaseLayout title="AI query fanout examples" canonicalPath="/examples" alternatePath="/de/beispiele" description="Dated, reproducible OpenAI query fanout observations for model comparison, country context, repeat variability and comparison sources."><header class="page-head"><h1>Examples you can inspect.</h1><div class="page-head-copy"><p>Real, dated API observations with the input, protocol, query strings, source domains, token use and limits kept together.</p><p class="meta-line">Collected 27 Aug 2026 · owner-run · not an independent benchmark</p></div></header><section class="example-index section-pad">{englishExamples.map((page,index)=><a href={`/examples/${page.slug}`}><span>{String(index+1).padStart(2,"0")}</span><div><strong>{page.title}</strong><p>{page.question}</p></div><ArrowIcon/></a>)}</section><section class="research-plan section-pad"><div><p>REPEATABLE EVIDENCE</p><h2>A fixed set of 12 topics for monthly runs.</h2></div><div><p>The topic set covers informational, comparison, commercial, troubleshooting, implementation and local questions. It fixes input, locale and reporting fields before the next runs happen. This is a research plan, not a page of claimed results.</p><nav><a href="/examples/monthly-observation-plan.v1.json">Open observation plan</a><a href="/examples/openai-observations-2026-08-27.csv">Download current CSV</a><a href="/contracts/example-observation.schema.v1.json">View schema v1</a></nav></div></section></BaseLayout><style>.example-index{display:grid}.example-index a{display:grid;grid-template-columns:4rem 1fr auto;gap:1rem;align-items:center;padding:1.5rem 0;border-bottom:1px solid var(--rule);text-decoration:none}.example-index span{color:var(--source);font: .7rem/1 var(--font-mono)}.example-index strong{font-size:1.15rem}.example-index p{margin:.4rem 0 0;color:var(--muted)}.research-plan{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,8vw,8rem);border-top:1px solid var(--rule)}.research-plan>div:first-child>p{color:var(--source);font:.65rem/1 var(--font-mono)}.research-plan h2{max-width:18ch;margin:1rem 0 0;font-size:clamp(2rem,4vw,3.5rem)}.research-plan>div:last-child>p{margin:0;color:var(--muted);font-size:1.05rem;line-height:1.7}.research-plan nav{display:flex;flex-wrap:wrap;gap:1.25rem;margin-top:2rem}.research-plan a{color:var(--source)}@media(max-width:600px){.example-index a{grid-template-columns:2.5rem 1fr}.example-index svg{display:none}.research-plan{grid-template-columns:1fr}}</style>
