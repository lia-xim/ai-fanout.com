---
import BaseLayout from "../../layouts/BaseLayout.astro";import ArrowIcon from "../../components/ArrowIcon.astro";import { englishExamples } from "../../data/examples";
---
<BaseLayout title="AI query fanout examples" canonicalPath="/examples" alternatePath="/de/beispiele" description="Dated, reproducible OpenAI query fanout observations for model comparison, country context, repeat variability and comparison sources."><header class="page-head"><h1>Examples you can inspect.</h1><div class="page-head-copy"><p>Real, dated API observations with the input, protocol, query strings, source domains, token use and limits kept together.</p><p class="meta-line">Collected 27 Aug 2026 · owner-run · not an independent benchmark</p></div></header><section class="example-index section-pad">{englishExamples.map((page,index)=><a href={`/examples/${page.slug}`}><span>{String(index+1).padStart(2,"0")}</span><div><strong>{page.title}</strong><p>{page.question}</p></div><ArrowIcon/></a>)}</section></BaseLayout><style>.example-index{display:grid}.example-index a{display:grid;grid-template-columns:4rem 1fr auto;gap:1rem;align-items:center;padding:1.5rem 0;border-bottom:1px solid var(--rule);text-decoration:none}.example-index span{color:var(--source);font: .7rem/1 var(--font-mono)}.example-index strong{font-size:1.15rem}.example-index p{margin:.4rem 0 0;color:var(--muted)}@media(max-width:600px){.example-index a{grid-template-columns:2.5rem 1fr}.example-index svg{display:none}}</style>
