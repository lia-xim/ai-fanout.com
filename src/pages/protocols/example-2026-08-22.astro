---
import ArrowIcon from "../../components/ArrowIcon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { governance } from "../../data/research";
import fixture from "../../../public/examples/evidence-lab-example-2026-08-22.json";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: "Reproducible Evidence Lab example protocol",
  datePublished: "2026-08-22",
  dateModified: "2026-08-22",
  author: { "@type": "Person", name: governance.researchOwner },
  about: "A synthetic worked example for a browser-local AI answer evidence workflow",
  isBasedOn: "https://ai-fanout.com/methodology",
};
---

<BaseLayout
  title="Reproducible example protocol"
  canonicalPath="/protocols/example-2026-08-22"
  description="A dated, fully traceable synthetic Evidence Lab example with exact inputs, calculations, outputs and limitations."
  structuredData={structuredData}
>
  <header class="example-head">
    <p class="example-kicker">AF-EX-2026-08-22 · method 0.1 · published 22 August 2026</p>
    <h1>A result you can reproduce—not a benchmark.</h1>
    <p>This worked protocol uses only owner-created synthetic answers and reserved <code>.example</code> source hosts. It demonstrates the Evidence Lab calculation contract. It does not compare real providers, measure model quality or support a market claim.</p>
    <div class="example-actions"><a class="button" href="/examples/evidence-lab-example-2026-08-22.json" download>Download exact JSON</a><a class="text-action" href="/lab">Open the Evidence Lab <ArrowIcon /></a></div>
  </header>

  <section class="accountability section-pad section-rule" aria-labelledby="accountability-title">
    <div><span class="section-number">01</span><h2 id="accountability-title" class="section-title">Accountability</h2></div>
    <dl>
      <div><dt>Research owner</dt><dd>{governance.researchOwner}</dd></div>
      <div><dt>Protocol version</dt><dd>Method 0.1; assigned and maintained by Matthias Ramahi</dd></div>
      <div><dt>Corrections</dt><dd>Affected record, reason, date, reviewer status and comparability effect are versioned by the Research Owner.</dd></div>
      <div><dt>Reviewer status</dt><dd>No independent reviewer assigned; independent review is not claimed.</dd></div>
      <div><dt>Provider/API cost</dt><dd>EUR 0; this example makes no provider or API call.</dd></div>
    </dl>
  </section>

  <section class="section-pad section-rule" aria-labelledby="reproduce-title">
    <span class="section-number">02</span><h2 id="reproduce-title" class="section-title">Reproduction steps</h2>
    <ol class="steps ruled-list">
      <li><span>01</span><p>Open <a href="/lab">Evidence Lab</a> and choose <strong>Load synthetic demo</strong>.</p></li>
      <li><span>02</span><p>Confirm the exact question, four criteria and three observations shown below.</p></li>
      <li><span>03</span><p>Choose <strong>Analyze observations</strong>. The deterministic method normalizes visible hosts, performs literal case-insensitive phrase checks and computes mean pairwise token Jaccard after the published stop-word filter.</p></li>
      <li><span>04</span><p>Compare the five summary values with the dated JSON fixture. The generated timestamp may differ; inputs and calculated values must not.</p></li>
    </ol>
  </section>

  <section class="metric-section section-pad section-rule" aria-labelledby="result-title">
    <span class="section-number">03</span><h2 id="result-title" class="section-title">Expected result</h2>
    <dl class="metric-rail">
      <div><dt>Observations</dt><dd>{fixture.observations.length}</dd><small>synthetic records</small></div>
      <div><dt>Unique domains</dt><dd>{fixture.metrics.unique_source_domains}</dd><small>reserved hosts</small></div>
      <div><dt>Recurring domains</dt><dd>{fixture.metrics.recurring_source_domains} / {fixture.metrics.unique_source_domains}</dd><small>present in 2+ records</small></div>
      <div><dt>Answer overlap</dt><dd>{Math.round(fixture.metrics.mean_answer_token_jaccard * 100)}%</dd><small>mean pairwise Jaccard</small></div>
      <div><dt>Literal coverage</dt><dd>{fixture.metrics.literal_coverage_matches} / {fixture.metrics.literal_coverage_cells}</dd><small>matched cells</small></div>
    </dl>
  </section>

  <section class="section-pad section-rule" aria-labelledby="inputs-title">
    <span class="section-number">04</span><h2 id="inputs-title" class="section-title">Exact inputs</h2>
    <div class="question-record"><strong>Question</strong><p>{fixture.question}</p><strong>Criteria</strong><ul>{fixture.criteria.map((criterion) => <li>{criterion}</li>)}</ul></div>
    <div class="observation-ledger">
      {fixture.observations.map((observation) => (
        <article>
          <header><span>{observation.label}</span><small>{observation.observedAt} · {observation.locale}</small></header>
          <dl><div><dt>Surface</dt><dd>{observation.surface}</dd></div><div><dt>Version</dt><dd>{observation.model}</dd></div><div><dt>Route</dt><dd>{observation.route}</dd></div></dl>
          <blockquote>{observation.answer}</blockquote>
          <p class="source-line">Visible hosts · {observation.sources.map((source) => source.host).join(" · ")}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="limitations section-pad" aria-labelledby="limits-title">
    <div><span class="section-number">05</span><h2 id="limits-title" class="section-title">What this proves—and what it cannot</h2></div>
    <div><p><strong>It proves:</strong> with these disclosed inputs and method 0.1, the local tool produces the values above. The fixture creates an inspectable regression target for future corrections.</p><p><strong>It does not prove:</strong> anything about ChatGPT, Gemini, Perplexity or another provider. No provider output was queried or retained, the example is not independently reviewed, and recurring hosts do not establish source quality or answer accuracy.</p><p>Future real-output research still requires a frozen protocol, independent reviewer status, a cost ceiling, provider-specific retention and publication review, and comparable batches.</p></div>
  </section>
</BaseLayout>

<style>
  .example-head { padding: clamp(4rem, 9vw, 8rem) clamp(1rem, 4vw, 4.5rem); border-bottom: 1px solid var(--rule); }
  .example-kicker { color: var(--signal); font: 0.72rem/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; }
  .example-head h1 { max-width: 10ch; margin: 1.25rem 0; font: 400 clamp(3.4rem, 8vw, 8rem)/0.9 var(--font-display); letter-spacing: -0.055em; }
  .example-head > p:not(.example-kicker) { max-width: 62ch; font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.65; }
  .example-actions { display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center; margin-top: 2rem; }
  .accountability, .limitations { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: clamp(2rem, 7vw, 8rem); }
  .accountability dl { margin: 0; border-top: 1px solid var(--rule); }
  .accountability dl > div { display: grid; grid-template-columns: minmax(9rem, 0.45fr) 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--fine-rule); }
  dt { font: 0.72rem/1.4 var(--font-mono); text-transform: uppercase; }
  dd { margin: 0; line-height: 1.55; }
  .steps { margin-top: 2rem; }
  .steps li { display: grid; grid-template-columns: 4rem 1fr; padding: 1rem 0; }
  .steps span { color: var(--signal); font-family: var(--font-mono); }
  .steps p { max-width: 68ch; margin: 0; line-height: 1.6; }
  .metric-section .metric-rail { margin-top: 2rem; }
  .question-record { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 1rem; max-width: 64rem; padding: 1.5rem 0; border-block: 1px solid var(--rule); }
  .question-record > strong { font: 0.72rem/1.4 var(--font-mono); text-transform: uppercase; }
  .question-record p, .question-record ul { margin: 0; line-height: 1.6; }
  .observation-ledger { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 2rem; background: var(--rule); border: 1px solid var(--rule); }
  .observation-ledger article { padding: clamp(1rem, 2vw, 1.5rem); background: var(--paper); }
  .observation-ledger header { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--fine-rule); }
  .observation-ledger header span { color: var(--signal); font: 0.76rem/1.3 var(--font-mono); }
  .observation-ledger header small { text-align: right; }
  .observation-ledger dl > div { display: grid; grid-template-columns: 5rem 1fr; gap: 0.5rem; margin-top: 0.7rem; }
  .observation-ledger blockquote { margin: 1.25rem 0; font-size: 0.95rem; line-height: 1.6; }
  .source-line { color: var(--muted); font: 0.68rem/1.5 var(--font-mono); }
  .limitations p { max-width: 64ch; margin: 0 0 1rem; line-height: 1.65; }
  @media (max-width: 900px) { .observation-ledger { grid-template-columns: 1fr; } }
  @media (max-width: 720px) { .accountability, .limitations { grid-template-columns: 1fr; } .accountability dl > div, .question-record { grid-template-columns: 1fr; } }
</style>
