---
import ArrowIcon from "../components/ArrowIcon.astro";import FanoutPlanner from "../components/FanoutPlanner.astro";import BaseLayout from "../layouts/BaseLayout.astro";
const appSchema={"@context":"https://schema.org","@type":"WebApplication",name:"AI Fanout Planner",url:"https://ai-fanout.com/",applicationCategory:"BusinessApplication",operatingSystem:"Any",description:"A bounded tool that turns one short question into a transparent set of plausible research and content-planning branches.",offers:{"@type":"Offer",price:"0",priceCurrency:"EUR"},creator:{"@type":"Person",name:"Matthias Ramahi"},featureList:["4–8 planner-generated branches","Intent and source-type labels","Explicit assumptions and version metadata"]};
---
<BaseLayout canonicalPath="/" pageClass="planner-home" structuredData={appSchema}>
  <section class="planner-hero"><div><h1>One question.<br/><span>Its useful edges.</span></h1><p>Turn a short question into 4–8 plausible longtails and subquestions—with intent, rationale, source type and assumptions visible.</p><a class="button" href="#planner">Build a fanout <ArrowIcon/></a><ul><li>Max 120 characters</li><li>Transparent method</li><li>No raw storage</li></ul></div><figure><figcaption><span>Illustrative branch map</span><small>Not provider-internal data</small></figcaption><div class="origin">YOUR<br/>QUESTION</div><ol><li>Learn the concept</li><li>Compare approaches</li><li>Verify the evidence</li><li>Plan implementation</li><li>Find failure modes</li></ol></figure></section>
  <div id="planner" class="planner-stage"><header><span>01 / PLANNER</span><h2>Start with one real question.</h2><p>The result is a planning aid. It never claims to expose Google, ChatGPT, retrieval or chain-of-thought internals.</p></header><FanoutPlanner/></div>
  <section class="contract"><div><span>Input</span><strong>One short question</strong><p>No URLs, files or extra context.</p></div><div><span>Output</span><strong>Planner hypotheses</strong><p>Not hidden provider queries.</p></div><div><span>Trace</span><strong>Model + version</strong><p>Method and assumptions attached.</p></div><div><span>Privacy</span><strong>No raw storage</strong><p>Prompt and result are not retained by us.</p></div></section>
  <section class="secondary section-pad section-rule"><div><span class="section-number">SECONDARY TOOL</span><h2 class="section-title">Already have public AI answers?</h2><p>Use the browser-local Answer Evidence Lab to compare visible source URLs, literal coverage and answer overlap. Nothing entered there leaves your browser.</p><a class="text-action" href="/lab">Open the Evidence Lab <ArrowIcon/></a></div><div class="steps"><span>PASTE</span><i></i><span>COMPARE</span><i></i><span>EXPORT</span></div></section>
  <section class="method section-pad"><p>Transparent by construction</p><h2>The planner shows assumptions. It does not pretend to show a model’s thoughts.</h2><a href="/methodology">Read the planner methodology <ArrowIcon/></a></section>
</BaseLayout>
<style>
.planner-hero{display:grid;grid-template-columns:minmax(25rem,.92fr) minmax(30rem,1.08fr);gap:clamp(3rem,8vw,9rem);align-items:center;min-height:calc(100dvh - 5.25rem);padding:clamp(4rem,8vw,8rem) var(--gutter);border-bottom:1px solid var(--rule)}.planner-hero h1{margin:0;font:780 clamp(4.2rem,7.5vw,8.6rem)/.84 var(--font-display);letter-spacing:-.08em}.planner-hero h1 span{color:var(--source)}.planner-hero>div>p{max-width:48ch;margin:2rem 0;color:#bcc6ca;font-size:clamp(1.05rem,1.5vw,1.27rem);line-height:1.65}.planner-hero ul{display:flex;flex-wrap:wrap;margin:2rem 0 0;padding:0;list-style:none}.planner-hero li{padding:.4rem .8rem;border-left:1px solid var(--fine-rule);color:var(--muted);font:.62rem/1 var(--font-mono);text-transform:uppercase}.planner-hero li:first-child{padding-left:0;border:0}.planner-hero figure{position:relative;min-height:31rem;margin:0;padding:5rem 2rem 2rem;border:1px solid var(--rule);background:linear-gradient(145deg,rgba(39,199,244,.07),transparent 45%),var(--surface)}figure figcaption{position:absolute;top:0;right:0;left:0;display:flex;justify-content:space-between;padding:1rem;border-bottom:1px solid var(--fine-rule);color:var(--muted);font:.6rem/1.4 var(--font-mono);text-transform:uppercase}figure small{color:var(--signal)}.origin{display:grid;width:8rem;height:8rem;place-items:center;margin:6rem 0;border:1px solid var(--source);border-radius:50%;font:.65rem/1.4 var(--font-mono);text-align:center}.planner-hero figure ol{position:absolute;top:6rem;right:2rem;bottom:3rem;display:grid;align-content:space-around;width:52%;margin:0;padding:0;list-style:none}.planner-hero figure li{position:relative;padding:.8rem;border-left:1px solid var(--source);background:rgba(255,255,255,.025);color:var(--ink);font:.7rem/1.3 var(--font-mono)}.planner-hero figure li:before{position:absolute;right:100%;top:50%;width:5rem;height:1px;background:var(--fine-rule);content:""}.planner-stage{padding:clamp(4rem,8vw,8rem) var(--gutter)}.planner-stage>header{display:grid;grid-template-columns:.3fr .8fr .9fr;gap:2rem;margin-bottom:3rem}.planner-stage>header span{color:var(--source);font:.65rem/1.4 var(--font-mono)}.planner-stage>header h2{margin:0;font:720 clamp(2.5rem,5vw,5rem)/.96 var(--font-display);letter-spacing:-.055em}.planner-stage>header p{max-width:45ch;margin:0;color:var(--muted);line-height:1.65}.planner-stage :global([data-planner-form]){display:grid;padding:clamp(1.5rem,3vw,2.5rem);border:1px solid var(--rule);background:var(--surface)}.planner-stage :global(label){margin-bottom:1rem;color:var(--muted);font:.65rem/1 var(--font-mono);text-transform:uppercase}.planner-stage :global(textarea){min-height:7rem;padding:.5rem 0;border:0;border-bottom:1px solid var(--source);outline:0;background:transparent;color:var(--ink);font:650 clamp(1.6rem,3.2vw,3.2rem)/1.15 var(--font-display);resize:vertical}.planner-stage :global(output){justify-self:end;margin:.7rem 0;color:var(--muted);font:.63rem/1 var(--font-mono)}.planner-stage :global(button){justify-self:start;margin-top:1.2rem;padding:1rem 1.3rem;border:1px solid var(--source);background:var(--source);color:#041014;font-weight:750}.planner-stage :global(button:disabled){border-color:var(--rule);background:#1a2125;color:#778287}.planner-stage :global([data-planner-form] p){max-width:70ch;color:var(--signal);font-size:.78rem;line-height:1.5}.planner-stage :global([data-plan-output]){margin-top:4rem;border-top:1px solid var(--source)}.planner-stage :global([data-plan-output]>h2){max-width:20ch;font:700 clamp(2.2rem,4vw,4rem)/1 var(--font-display)}.planner-stage :global(dl){display:flex;flex-wrap:wrap;gap:2rem;padding-block:1rem;border-block:1px solid var(--fine-rule)}.planner-stage :global(dl div){display:flex;gap:.6rem;font:.65rem/1.4 var(--font-mono)}.planner-stage :global(dd){margin:0;color:var(--source)}.planner-stage :global([data-plan-branches]){margin:0;padding:0;list-style:none}.planner-stage :global([data-plan-branches] li){display:grid;grid-template-columns:minmax(16rem,.7fr) 1.3fr;gap:2rem;padding:1.3rem 0;border-bottom:1px solid var(--fine-rule)}.planner-stage :global([data-plan-branches] p){margin:0;color:var(--muted);font-size:.8rem;line-height:1.55}.planner-stage :global(aside){display:grid;grid-template-columns:1fr auto;gap:3rem;margin-top:4rem;padding:2rem 0;border-top:1px solid var(--signal)}.planner-stage :global(aside h3){font:700 clamp(2rem,4vw,3.7rem)/1 var(--font-display)}.planner-stage :global(aside small){display:block;max-width:70ch;color:var(--muted)}.planner-stage :global(aside nav){display:grid;align-content:end;gap:1rem}.contract{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--rule)}.contract div{padding:2rem var(--gutter)}.contract div+div{border-left:1px solid var(--fine-rule)}.contract span{color:var(--source);font:.62rem/1 var(--font-mono);text-transform:uppercase}.contract strong{display:block;margin:1.2rem 0 .5rem}.contract p{margin:0;color:var(--muted);font-size:.75rem}.secondary{display:grid;grid-template-columns:1fr minmax(25rem,.8fr);gap:5rem;align-items:center}.secondary p{max-width:55ch;color:var(--muted);line-height:1.65}.steps{display:grid;grid-template-columns:auto 1fr auto 1fr auto;align-items:center}.steps span{display:grid;width:6rem;height:6rem;place-items:center;border:1px solid var(--rule);font:.6rem/1 var(--font-mono)}.steps i{height:1px;background:var(--source)}.method{display:grid;grid-template-columns:.35fr 1fr auto;gap:3rem;align-items:end}.method>p{color:var(--source);font:.65rem/1.4 var(--font-mono);text-transform:uppercase}.method h2{margin:0;font:700 clamp(2.5rem,5vw,5rem)/.96 var(--font-display);letter-spacing:-.055em}.method a{display:inline-flex;gap:.7rem;padding:.9rem;border:1px solid var(--rule);font-size:.78rem;text-decoration:none}
@media(max-width:900px){.planner-hero,.secondary,.method,.planner-stage>header{grid-template-columns:1fr}.planner-hero{min-height:0}.contract{grid-template-columns:1fr 1fr}.contract div:nth-child(3){border-left:0;border-top:1px solid var(--fine-rule)}.contract div:nth-child(4){border-top:1px solid var(--fine-rule)}.planner-stage :global(aside){grid-template-columns:1fr}}@media(max-width:600px){.planner-hero{grid-template-columns:1fr;padding-block:4rem}.planner-hero h1{font-size:clamp(4rem,18vw,6rem)}.planner-hero figure{min-height:25rem}.origin{width:6rem;height:6rem}.planner-hero figure ol{right:1rem;width:56%}.contract{grid-template-columns:1fr}.contract div+div,.contract div:nth-child(3){border-top:1px solid var(--fine-rule);border-left:0}.planner-stage :global([data-plan-branches] li){grid-template-columns:1fr;gap:.5rem}.steps span{width:5rem;height:5rem}}
</style>
