---
import ArrowIcon from "../../components/ArrowIcon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { libraryArticles, libraryGroups } from "../../data/library";
const categoryLabels = { Concept: "Basics", Measurement: "Check results", Method: "How to", "Data standard": "Data and exports", "Field guide": "Practical guides" } as const;
---

<BaseLayout title="Learn about AI query fanout" canonicalPath="/library" alternatePath="/de/lernen" description="Clear guides to AI query fanout, OpenAI web search, citations, changing results and practical SEO use.">
  <header class="library-hero">
    <div class="library-kicker"><span>Learn</span><span>{libraryArticles.length} practical guides</span></div>
    <div class="library-hero-grid">
      <h1>See what happens after the keyword.</h1>
      <div>
        <p>Learn what query fanout is, which searches an API can expose, what citations prove, and how to use the result without overclaiming.</p>
        <p class="meta-line">Plain-English guides · reviewed 27 Aug 2026</p>
      </div>
    </div>
    <div class="signal-legend" aria-label="Learning path">
      <span><i aria-hidden="true"></i>Keyword</span><span><i aria-hidden="true"></i>Queries</span><span><i aria-hidden="true"></i>Sources</span><span><i aria-hidden="true"></i>Action</span>
    </div>
  </header>

  <section class="library-index section-pad section-rule" aria-labelledby="library-index-title">
    <div class="index-heading">
      <div><span class="section-number">01</span><h2 id="library-index-title" class="section-title">Choose your question</h2></div>
      <p>Every guide answers one distinct question about the tool, its evidence, or what to do with the result.</p>
    </div>
    <div class="library-filters" aria-label="Filter the learning guides">
      <button type="button" data-filter="all" aria-pressed="true">All <span>{libraryArticles.length}</span></button>
      {libraryGroups.map((group) => <button type="button" data-filter={group.category} aria-pressed="false">{categoryLabels[group.category]} <span>{group.articles.length}</span></button>)}
    </div>
    <ol class="library-list" aria-live="polite">
      {libraryArticles.map((article) => (
        <li data-library-item data-category={article.category}>
          <a href={`/library/${article.slug}`}>
            <span class="entry-number">{article.number}</span>
            <span class="entry-type">{categoryLabels[article.category]}</span>
            <span class="entry-main"><strong>{article.shortTitle}</strong><small>{article.primaryIntent}</small></span>
            <ArrowIcon />
          </a>
        </li>
      ))}
    </ol>
    <p class="filter-empty" hidden data-filter-empty>No guides match this filter.</p>
  </section>

  <section class="library-map section-pad section-rule" aria-labelledby="map-title">
    <div><span class="section-number">02</span><h2 id="map-title" class="section-title">From question to decision</h2></div>
    <ol>
      <li><span>01</span><div><h3>Understand the idea</h3><p>Learn what query fanout is and what an outside tool cannot see.</p></div></li>
      <li><span>02</span><div><h3>Group the observed queries</h3><p>Combine wording variants that serve the same reader job.</p></div></li>
      <li><span>03</span><div><h3>Check the returned sources</h3><p>Use only relationships and claims the provider response can support.</p></div></li>
      <li><span>04</span><div><h3>Make the smallest useful change</h3><p>Decide whether the branch needs a page, a section, more research, or no action.</p></div></li>
    </ol>
  </section>

  <section class="library-boundary section-pad">
    <p>Need the short version? See the tool's steps, limits, and privacy rules.</p>
    <a class="text-action" href="/methodology">See how the free tool works <ArrowIcon /></a>
  </section>

  <script>
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const libraryItems = Array.from(document.querySelectorAll<HTMLElement>("[data-library-item]"));
    const emptyState = document.querySelector<HTMLElement>("[data-filter-empty]");

    for (const button of filterButtons) {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter ?? "all";
        for (const candidate of filterButtons) candidate.setAttribute("aria-pressed", String(candidate === button));
        let visible = 0;
        for (const item of libraryItems) {
          const show = filter === "all" || item.dataset.category === filter;
          item.hidden = !show;
          if (show) visible += 1;
        }
        if (emptyState) emptyState.hidden = visible !== 0;
      });
    }
  </script>
</BaseLayout>

<style>
  .library-hero { padding: clamp(3.5rem, 7vw, 7rem) var(--gutter) 0; border-bottom: 1px solid var(--rule); }
  .library-kicker { display: flex; justify-content: space-between; gap: 2rem; padding-bottom: 1.15rem; border-bottom: 1px solid var(--fine-rule); color: var(--muted); font: 0.68rem/1.4 var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase; }
  .library-kicker span:first-child { color: var(--source); }
  .library-hero-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(19rem, 0.7fr); gap: clamp(2.5rem, 8vw, 9rem); align-items: end; padding-block: clamp(3.2rem, 6vw, 6rem); }
  .library-hero h1 { max-width: 10ch; margin: 0; font: 790 clamp(4rem, 8vw, 8.5rem)/0.88 var(--font-display); letter-spacing: -0.075em; text-wrap: balance; }
  .library-hero-grid p:first-child { max-width: 38ch; margin: 0; color: #c5cdd0; font-size: clamp(1.08rem, 1.6vw, 1.38rem); line-height: 1.6; }
  .signal-legend { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--rule); }
  .signal-legend span { display: flex; min-height: 4.25rem; align-items: center; gap: 0.8rem; color: var(--muted); font: 0.7rem/1.4 var(--font-mono); text-transform: uppercase; }
  .signal-legend span + span { padding-left: 1rem; border-left: 1px solid var(--fine-rule); }
  .signal-legend i { width: 0.65rem; height: 0.65rem; border: 1px solid var(--source); border-radius: 50%; }
  .signal-legend span:last-child i { border-color: var(--signal); }
  .index-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.5fr); gap: 3rem; align-items: end; }
  .index-heading > p { max-width: 48ch; margin: 0; color: var(--muted); font-size: 0.88rem; line-height: 1.6; }
  .library-filters { display: flex; flex-wrap: wrap; margin-top: 3rem; border-block: 1px solid var(--rule); }
  .library-filters button { min-height: 3.3rem; padding: 0.8rem 1rem; border: 0; border-right: 1px solid var(--fine-rule); background: transparent; color: var(--muted); cursor: pointer; font: 0.72rem/1.3 var(--font-mono); }
  .library-filters button span { margin-left: 0.45rem; color: #68757a; }
  .library-filters button[aria-pressed="true"] { background: var(--source); color: #041014; }
  .library-filters button[aria-pressed="true"] span { color: #125268; }
  .library-list { margin: 0; padding: 0; list-style: none; }
  .library-list li { border-bottom: 1px solid var(--fine-rule); }
  .library-list li[hidden] { display: none; }
  .library-list a { display: grid; grid-template-columns: 5rem 8.5rem minmax(0, 1fr) 1.5rem; gap: 1.25rem; align-items: center; min-height: 6.1rem; padding: 1rem 0.65rem; text-decoration: none; transition: background-color 180ms ease, transform 180ms var(--ease-out); }
  .library-list a:hover { background: rgba(39, 199, 244, 0.035); transform: translateX(0.3rem); }
  .entry-number, .entry-type { color: var(--muted); font: 0.7rem/1.4 var(--font-mono); text-transform: uppercase; }
  .entry-type { color: var(--source); }
  .entry-main { display: grid; grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1fr); gap: 2rem; align-items: baseline; }
  .entry-main strong { font-size: clamp(1.05rem, 1.6vw, 1.35rem); }
  .entry-main small { max-width: 62ch; color: var(--muted); font-size: 0.82rem; line-height: 1.55; }
  .library-list svg { color: var(--muted); transition: color 180ms ease, transform 180ms var(--ease-out); }
  .library-list a:hover svg { color: var(--source); transform: translateX(0.2rem); }
  .filter-empty { margin: 2rem 0 0; color: var(--muted); }
  .library-map { display: grid; grid-template-columns: minmax(18rem, 0.65fr) minmax(0, 1.35fr); gap: clamp(3rem, 8vw, 9rem); }
  .library-map ol { margin: 0; padding: 0; border-top: 1px solid var(--rule); list-style: none; counter-reset: library-step; }
  .library-map li { position: relative; display: grid; grid-template-columns: 4rem 1fr; gap: 1.5rem; padding: 1.4rem 0; border-bottom: 1px solid var(--fine-rule); }
  .library-map li > span { color: var(--signal); font: 0.72rem/1.5 var(--font-mono); }
  .library-map h3 { margin: 0; font-size: 1rem; }
  .library-map p { max-width: 48ch; margin: 0.45rem 0 0; color: var(--muted); font-size: 0.86rem; line-height: 1.55; }
  .library-boundary { display: flex; justify-content: space-between; gap: 3rem; align-items: center; }
  .library-boundary > p { max-width: 28ch; margin: 0; font: 450 clamp(2rem, 4vw, 4rem)/1.04 var(--font-display); letter-spacing: -0.045em; }
  @media (max-width: 820px) {
    .library-hero-grid, .index-heading, .library-map { grid-template-columns: 1fr; }
    .library-hero-grid { gap: 2.5rem; }
    .signal-legend { grid-template-columns: 1fr 1fr; }
    .signal-legend span:nth-child(3) { border-left: 0; }
    .signal-legend span:nth-child(n+3) { border-top: 1px solid var(--fine-rule); }
    .library-list a { grid-template-columns: 3.5rem minmax(0, 1fr) 1.5rem; }
    .entry-type { grid-column: 2; grid-row: 1; justify-self: end; }
    .entry-main { grid-column: 2; grid-template-columns: 1fr; gap: 0.5rem; }
    .library-list svg { grid-column: 3; grid-row: 1 / span 2; }
    .library-boundary { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 520px) {
    .library-hero { padding-top: 2.5rem; }
    .library-kicker { align-items: flex-start; flex-direction: column; gap: 0.45rem; }
    .library-hero h1 { font-size: clamp(3.5rem, 18vw, 5.4rem); }
    .library-filters { display: grid; grid-template-columns: 1fr 1fr; }
    .library-filters button { text-align: left; }
    .library-list a { grid-template-columns: 3rem minmax(0, 1fr) 1rem; padding-inline: 0; }
    .entry-type { justify-self: start; }
  }
</style>
