---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import "../styles/global.css";
import "../styles/polish.css";
interface Props { title?: string; description?: string; canonicalPath?: string; alternatePath?: string; pageClass?: string; robots?: string; structuredData?: Record<string, unknown>; lang?: "en" | "de"; ogType?: "website" | "article"; socialImagePath?: string; socialImageAlt?: string }
const { title, description = site.description, canonicalPath, alternatePath, pageClass = "", robots, structuredData, lang = site.language, ogType = "website", socialImagePath = "/social/ai-fanout-planner.png", socialImageAlt = "AI Query Fanout tool" } = Astro.props;
const pageTitle = title ? `${title} — ${site.domain}` : site.title;
const canonical = canonicalPath === undefined ? undefined : new URL(canonicalPath, `${site.url}/`).toString();
const alternate = alternatePath === undefined ? undefined : new URL(alternatePath, `${site.url}/`).toString();
const englishUrl = lang === "en" ? canonical : alternate;
const germanUrl = lang === "de" ? canonical : alternate;
const currentPath = Astro.url.pathname;
const websiteData = { "@context": "https://schema.org", "@type": "WebSite", name: site.title, url: site.url, description: site.description, inLanguage: lang };
const socialImage = new URL(socialImagePath, `${site.url}/`).toString();
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='10' fill='%23080b0d'/%3E%3Ccircle cx='32' cy='32' r='17' fill='none' stroke='%2327c7f4' stroke-width='3'/%3E%3Ccircle cx='32' cy='32' r='6' fill='%2327c7f4'/%3E%3C/svg%3E";
---
<!doctype html><html lang={lang} data-design="controlled-signal"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>{robots && <meta name="robots" content={robots}/>}<meta name="description" content={description}/><meta name="theme-color" content="#080b0d"/><link rel="icon" href={favicon}/>{canonical && <link rel="canonical" href={canonical}/>} {englishUrl && germanUrl && <><link rel="alternate" hreflang="en" href={englishUrl}/><link rel="alternate" hreflang="de" href={germanUrl}/><link rel="alternate" hreflang="x-default" href={englishUrl}/></>}<meta property="og:type" content={ogType}/><meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"}/><meta property="og:site_name" content={site.title}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:image" content={socialImage}/><meta property="og:image:alt" content={socialImageAlt}/>{canonical && <meta property="og:url" content={canonical}/>}<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImage}/><meta name="twitter:image:alt" content={socialImageAlt}/><title>{pageTitle}</title><script is:inline type="application/ld+json" set:html={JSON.stringify(websiteData)}/>{structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}/>}</head><body class={pageClass}><a class="skip-link" href="#main-content">{lang === "de" ? "Zum Inhalt" : "Skip to content"}</a><div class="site-shell"><Header currentPath={currentPath} lang={lang} alternatePath={alternatePath}/><main id="main-content"><slot/></main><Footer lang={lang}/></div></body></html>
