---
import Header from "../components/Header.astro";import Footer from "../components/Footer.astro";import {site} from "../data/site";import "../styles/global.css";import "../styles/polish.css";
interface Props{title?:string;description?:string;canonicalPath?:string;pageClass?:string;robots?:string;structuredData?:Record<string,unknown>;lang?:"en"|"de"}
const{title,description=site.description,canonicalPath,pageClass="",robots,structuredData,lang=site.language}=Astro.props;const pageTitle=title?`${title} — ${site.domain}`:site.title;const canonical=canonicalPath===undefined?undefined:new URL(canonicalPath,`${site.url}/`).toString();const currentPath=Astro.url.pathname;const websiteData={"@context":"https://schema.org","@type":"WebSite",name:site.title,url:site.url,description:site.description,inLanguage:site.language};const socialImage=new URL("/social/ai-fanout-planner.png",`${site.url}/`).toString();const favicon="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='10' fill='%23080b0d'/%3E%3Ccircle cx='32' cy='32' r='17' fill='none' stroke='%2327c7f4' stroke-width='3'/%3E%3Ccircle cx='32' cy='32' r='6' fill='%2327c7f4'/%3E%3C/svg%3E";
---
<!doctype html><html lang={lang} data-design="controlled-signal"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>{robots&&<meta name="robots" content={robots}/>}<meta name="description" content={description}/><meta name="theme-color" content="#080b0d"/><link rel="icon" href={favicon}/>{canonical&&<link rel="canonical" href={canonical}/>}<meta property="og:type" content="website"/><meta property="og:site_name" content={site.title}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:image" content={socialImage}/>{canonical&&<meta property="og:url" content={canonical}/>}<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImage}/><title>{pageTitle}</title><script is:inline type="application/ld+json" set:html={JSON.stringify(websiteData)}/>{structuredData&&<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}/>}</head><body class={pageClass}><a class="skip-link" href="#main-content">Skip to content</a><div class="site-shell"><Header currentPath={currentPath}/><main id="main-content"><slot/></main><Footer/></div></body></html>

