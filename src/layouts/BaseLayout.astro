---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import "../styles/global.css";
import "../styles/polish.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  pageClass?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description = site.description, canonicalPath, pageClass = "", structuredData } = Astro.props;
const pageTitle = title ? `${title} — ${site.domain}` : site.title;
const canonical = canonicalPath === undefined ? undefined : new URL(canonicalPath, `${site.url}/`).toString();
const currentPath = Astro.url.pathname;
const websiteData = { "@context": "https://schema.org", "@type": "WebSite", name: site.title, url: site.url, description: site.description, inLanguage: site.language };
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='10' fill='%23080b0d'/%3E%3Ccircle cx='32' cy='32' r='17' fill='none' stroke='%2327c7f4' stroke-width='3'/%3E%3Ccircle cx='32' cy='32' r='6' fill='%2327c7f4'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang={site.language} data-design="controlled-signal">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={site.indexing.directive} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080b0d" />
    <link rel="icon" href={favicon} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={structuredData ? "article" : "website"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteData)} />
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <Header currentPath={currentPath} />
      <main id="main-content"><slot /></main>
      <Footer />
    </div>
  </body>
</html>
